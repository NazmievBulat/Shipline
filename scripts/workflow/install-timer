#!/usr/bin/env bash
# Switches the workflow on. Run once by the owner, in any checkout of the repository Shipline
# works on (or with it named, `--repo`), and again after the `PATH`, the place of its main
# checkout or the place of Shipline's checkout changes:
#
#   shipline install-timer
#
# Writes a systemd user service and timer, `workflow-tick`, that run `shipline tick` of this
# Shipline checkout on the repository's main checkout every 3 minutes, points the link
# `~/.local/bin/shipline` at that launcher (`launcher-link`), and creates the labels `workflow`
# and `audited` on GitHub when they are missing. Units it replaces that were not Shipline's are
# kept beside them as `*.before-shipline`: `shipline uninstall` puts them back.
#
#   systemctl --user list-timers workflow-tick.timer     when it runs next
#   journalctl --user -u workflow-tick.service           what each tick did
#   systemctl --user disable --now workflow-tick.timer   switch it off
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source "$here/launcher-link"
find_launcher
# The repository (`workflow_config.py`): SHIPLINE_REPO, else the one of the current folder.
config=$(python3 "$here/workflow_config.py" shell)
eval "$config"
main=$SHIPLINE_REPO
# The runner's installer of the shared GitHub budget's `gh`, where the repository holds one.
budget_installer=$main/.github/runner/install-github-budget.sh
if [[ -f $budget_installer ]]; then
  sh "$budget_installer"
fi
units=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user

create_label() {
  local name=$1 color=$2 description=$3
  grep -qxF "$name" <<<"$labels" ||
    gh label create "$name" --color "$color" --description "$description"
}

labels=$(gh label list --limit 1000 --json name --jq '.[].name') || {
  echo "cannot read the labels from GitHub; nothing was installed" >&2
  exit 1
}
create_label "$SHIPLINE_LABEL_WORKFLOW" 1D76DB "Picked up by the workflow: gets a worker, a review and a merge"
create_label "$SHIPLINE_LABEL_AUDITED" 0E8A16 "Its audit left nothing open"

mkdir -p "$units"
# Units written by a copy of the scripts in the repository's tree are kept as they were, once.
if [[ -e $units/workflow-tick.service ]] && ! grep -q '/bin/shipline" tick$' "$units/workflow-tick.service"; then
  for unit in workflow-tick.service workflow-tick.timer; do
    [[ ! -e $units/$unit || -e $units/$unit.before-shipline ]] || cp -p "$units/$unit" "$units/$unit.before-shipline"
  done
fi

# systemd gives a service a short PATH. The tick needs the one that finds `gh`, `tmux`,
# `claude` and the repository's own tools, which is the PATH of whoever runs this. A `%` is
# doubled because
# systemd reads it as the start of a placeholder.
#
# TMUX_TMPDIR goes along when it is set: it is where `tmux` keeps its sockets, and a tick that
# looked elsewhere would see no session and start a second worker for each draft.
#
# KillMode=process: the `tmux` servers the tick starts stay in this service's control group.
# By default systemd ends everything left in it when the tick exits, the sessions included.
#
# The paths of the checkouts are written so that systemd reads them as they are: a `%` doubled,
# and in the command also a `\$` doubled and quotation marks around a path that may hold a
# space. The repository is named to the tick, not only its folder.
escaped=${main//%/%%}
escaped_launcher=${launcher//%/%%}
cat >"$units/workflow-tick.service" <<UNIT
[Unit]
Description=Workflow tick: starts workers, squeezes idle sessions, removes what is finished

[Service]
Type=oneshot
WorkingDirectory=$escaped
Environment="PATH=${PATH//%/%%}"
Environment="SHIPLINE_REPO=$escaped"
${TMUX_TMPDIR:+Environment=\"TMUX_TMPDIR=${TMUX_TMPDIR//%/%%}\"}
ExecStart="${escaped_launcher//\$/\$\$}" tick
KillMode=process
UNIT

cat >"$units/workflow-tick.timer" <<UNIT
[Unit]
Description=Runs the workflow tick every 3 minutes

[Timer]
OnCalendar=*:0/3
AccuracySec=10s
RandomizedDelaySec=15s

[Install]
WantedBy=timers.target
UNIT

systemctl --user daemon-reload
systemctl --user enable --now workflow-tick.timer
link_launcher
echo "workflow-tick runs $launcher tick on $main every 3 minutes"
