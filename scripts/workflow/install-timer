#!/usr/bin/env bash
# Switches the workflow on. Run once by the owner, from any checkout, and again after the
# `PATH` or the place of the main checkout changes.
#
# Writes a systemd user service and timer, `workflow-tick`, that run `scripts/workflow/tick` of
# the main checkout every 3 minutes, and creates the labels `workflow` and `audited` on GitHub
# when they are missing.
#
#   systemctl --user list-timers workflow-tick.timer     when it runs next
#   journalctl --user -u workflow-tick.service           what each tick did
#   systemctl --user disable --now workflow-tick.timer   switch it off
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
sh "$here/../../.github/runner/install-github-budget.sh"
main=$(dirname "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)")
units=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user

create_label() {
  local name=$1 color=$2 description=$3
  grep -qxF "$name" <<<"$labels" ||
    gh label create "$name" --color "$color" --description "$description"
}

labels=$(gh label list --limit 1000 --json name --jq '.[].name') || {
  echo "cannot read the labels from GitHub; nothing was installed" >&2
  exit 1
}
create_label workflow 1D76DB "Picked up by the workflow: gets a worker, a review and a merge"
create_label audited 0E8A16 "Its audit left nothing open"

mkdir -p "$units"

# systemd gives a service a short PATH. The tick needs the one that finds `gh`, `tmux`,
# `claude` and the repository's own tools, which is the PATH of whoever runs this. A `%` is
# doubled because
# systemd reads it as the start of a placeholder.
#
# TMUX_TMPDIR goes along when it is set: it is where `tmux` keeps its sockets, and a tick that
# looked elsewhere would see no session and start a second worker for each draft.
#
# KillMode=process: the `tmux` servers the tick starts stay in this service's control group.
# By default systemd ends everything left in it when the tick exits, the sessions included.
#
# The path of the checkout is written so that systemd reads it as it is: a `%` doubled, and in
# the command also a `\$` doubled and quotation marks around a path that may hold a space.
escaped=${main//%/%%}
cat >"$units/workflow-tick.service" <<UNIT
[Unit]
Description=Workflow tick: starts workers, squeezes idle sessions, removes what is finished

[Service]
Type=oneshot
WorkingDirectory=$escaped
Environment="PATH=${PATH//%/%%}"
${TMUX_TMPDIR:+Environment=\"TMUX_TMPDIR=${TMUX_TMPDIR//%/%%}\"}
ExecStart="${escaped//\$/\$\$}/scripts/workflow/tick"
KillMode=process
UNIT

cat >"$units/workflow-tick.timer" <<UNIT
[Unit]
Description=Runs the workflow tick every 3 minutes

[Timer]
OnCalendar=*:0/3
AccuracySec=10s
RandomizedDelaySec=15s

[Install]
WantedBy=timers.target
UNIT

systemctl --user daemon-reload
systemctl --user enable --now workflow-tick.timer
echo "workflow-tick runs $main/scripts/workflow/tick every 3 minutes"
