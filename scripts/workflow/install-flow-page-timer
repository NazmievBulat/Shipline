#!/usr/bin/env bash
# Switches the flow page on. Run once by the machine's owner, from any checkout, and again after
# the `PATH`, the place of the main checkout or the local settings change.
#
# Writes a systemd user service and timer, `flow-page`, that run `scripts/workflow/flow-page` of
# the main checkout every 10 minutes. When the machine's local settings
# (`.github/runner/settings.sh`) name `flow_page_address` or `flow_page_port`, a user service
# `flow-page-serve` serves the page's folder on that port, bound to that address only; where to
# serve it is the machine owner's choice, never the repository's. Without them nothing is served,
# and a server installed before is stopped and removed.
#
# Another machine named in `shipline.json` is sampled with `ssh -o BatchMode=yes`: its key must
# work without a password or an agent, as the service has neither.
#
#   systemctl --user list-timers flow-page.timer     when it runs next
#   journalctl --user -u flow-page.service           what each pass did
#   systemctl --user disable --now flow-page.timer   switch it off
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
main=$(dirname "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)")
units=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
# "<address> <port>", or nothing when the settings name nowhere; settings that cannot be used
# stop it here, before anything is installed.
served=$(python3 -B "$here/flow_page.py" --settings)

mkdir -p "$units"

# systemd gives a service a short PATH: the pass needs the one that finds `gh`, `journalctl`
# and `ssh`. A `%` is doubled because systemd reads it as the start of a placeholder, and in the
# command also a `$`, with quotation marks around a path that may hold a space.
escaped=${main//%/%%}
command="\"${escaped//\$/\$\$}/scripts/workflow/flow-page\""
cat >"$units/flow-page.service" <<UNIT
[Unit]
Description=Flow page: where the workflow's time goes and which stage is the bottleneck now

[Service]
Type=oneshot
WorkingDirectory=$escaped
Environment="PATH=${PATH//%/%%}"
ExecStart=$command
UNIT

cat >"$units/flow-page.timer" <<UNIT
[Unit]
Description=Writes the flow page every 10 minutes

[Timer]
OnCalendar=*:0/10
AccuracySec=10s

[Install]
WantedBy=timers.target
UNIT

serve=$units/flow-page-serve.service
if [[ -z $served ]]; then
  if [[ -e $serve ]]; then
    systemctl --user disable --now flow-page-serve.service
    rm -f "$serve"
  fi
else
  # Started again every 30 seconds while it cannot bind: after a boot the address may come up
  # later than the user's services.
  cat >"$serve" <<UNIT
[Unit]
Description=Serves the flow page on the address and port of the machine's local settings

[Service]
WorkingDirectory=$escaped
Environment="PATH=${PATH//%/%%}"
ExecStart=$command --serve ${served#* }
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
UNIT
fi

systemctl --user daemon-reload
systemctl --user enable --now flow-page.timer
echo "flow-page writes the page every 10 minutes from $main"
if [[ -n $served ]]; then
  systemctl --user enable flow-page-serve.service
  systemctl --user restart flow-page-serve.service
  echo "and serves it on ${served% *} port ${served#* }"
fi
