#!/usr/bin/env bash
# Adds the four hooks that call `notify` to the owner's Claude settings,
# `~/.claude/settings.json`, so they apply in every worktree. Run once, by the owner, in the
# repository Shipline works on (or with it named, `--repo`):
#
#   shipline install-hooks
#
# A hook that is already there is not added again, and every other setting and hook is left as
# it is. The settings as they were before the first run are kept beside the file. The hooks call
# `notify` through the launcher of this Shipline checkout, on the repository's main checkout,
# whichever worktree this was run from. The link `~/.local/bin/shipline` is pointed at that
# launcher (`launcher-link`). A hook written when the scripts were in the repository is replaced,
# and kept exactly in `settings.json.shipline-replaced`: `shipline uninstall` puts it back.
set -euo pipefail

# Codex workers use a per-process callback, never an owner's global notify setting.
[[ $# == 0 ]] || { echo "usage: install-hooks" >&2; exit 2; }
settings=$HOME/.claude/settings.json
backup=$settings.before-workflow-hooks
record=$settings.shipline-replaced

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source "$here/launcher-link"
find_launcher
# The repository (`workflow_config.py`): SHIPLINE_REPO, else the one of the current folder.
config=$(python3 "$here/workflow_config.py" shell)
eval "$config"
# Through `bash`, quiet and never failing: a session is not disturbed when the checkout no
# longer has the launcher or the script.
command="bash $(printf '%q' "$launcher") --repo $(printf '%q' "$SHIPLINE_REPO") notify 2>/dev/null || true"

before='{}'
indent=2
if [[ -e $settings ]]; then
  before=$(jq . "$settings" 2>/dev/null) && jq -e 'type == "object"' >/dev/null <<<"$before" || {
    echo "$settings is not a JSON object; nothing was changed" >&2
    exit 1
  }
  # Keep the file's own indentation, so the change is only the added hooks. `sed` stops at
  # the first indented key itself: piped into `head` it is ended by a broken pipe when the
  # file is long, and `pipefail` then ends this script without a word.
  spaces=$(sed -n '/^\( \{1,7\}\)".*/{s//\1/p;q}' "$settings")
  indent=${#spaces}
  ((indent > 0)) || indent=2
fi
# Once the settings are known to be readable: a refusal above changes nothing.
link_launcher

# shellcheck disable=SC2016  # the dollars belong to jq
after=$(jq --indent "$indent" --arg command "$command" '
  # Ours is a command of exactly the shape written here, whatever checkouts it names, in whose
  # paths a character the shell reads is escaped; or of the shape written when the scripts were
  # in the repository: the one path of its `notify`.
  def is_ours:
    (.command // "")
    | test("^bash ([^;&|\\\\ ]|\\\\.)+/bin/shipline --repo ([^;&|\\\\ ]|\\\\.)+ notify 2>/dev/null \\|\\| true$")
      or test("^bash ([^;&|\\\\]|\\\\.)*/scripts/workflow/notify 2>/dev/null \\|\\| true$");
  def calls_notify($matcher):
    any(.[]?; (.matcher // "") == $matcher and any(.hooks[]?; is_ours));
  # A hook of ours that is there is pointed at these checkouts, in case one of them moved.
  def with_hook($event; $matcher):
    if (.hooks[$event] // []) | calls_notify($matcher) then
      .hooks[$event] |= map(
        if (.matcher // "") == $matcher
        then .hooks |= map(if is_ours then .command = $command else . end)
        else . end)
    else .hooks[$event] = (.hooks[$event] // []) + [
      (if $matcher == "" then {} else {matcher: $matcher} end)
      + {hooks: [{type: "command", command: $command, timeout: 10}]}
    ] end;
  with_hook("Stop"; "")
  | with_hook("UserPromptSubmit"; "")
  | with_hook("Notification"; "permission_prompt")
  | with_hook("PreToolUse"; "AskUserQuestion")' <<<"$before")

if [[ $(jq -S . <<<"$after") == "$(jq -S . <<<"$before")" ]]; then
  echo "the workflow hooks are already in $settings"
  exit 0
fi

# The hooks of the shape written when the scripts were in the repository, which ours replace,
# one an event, as they were. A later run adds what it replaces then.
# shellcheck disable=SC2016  # the dollars belong to jq
replaced=$(jq -c '
  def held:
    (.command // "") | test("^bash ([^;&|\\\\]|\\\\.)*/scripts/workflow/notify 2>/dev/null \\|\\| true$");
  . as $settings
  | reduce (["Stop", ""], ["UserPromptSubmit", ""], ["Notification", "permission_prompt"],
      ["PreToolUse", "AskUserQuestion"]) as [$event, $matcher] ({};
    ([$settings.hooks[$event][]? | select((.matcher // "") == $matcher) | .hooks[]? | select(held)]
      | first) as $hook
    | if $hook then .[$event] = {matcher: $matcher, hook: $hook} else . end)' <<<"$before")

mkdir -p "$(dirname "$settings")"
if [[ $replaced != "{}" ]]; then
  [[ ! -e $record ]] || replaced=$(jq -c --argjson now "$replaced" '. + $now' "$record")
  printf '%s\n' "$replaced" >"$record"
fi
# The first copy is the one from before any of this; a later run does not replace it.
[[ ! -e $settings || -e $backup ]] || cp "$settings" "$backup"
# Written through the file's own name, so a settings file that is a link stays one.
printf '%s\n' "$after" >"$settings"
echo "added the workflow hooks to $settings"
[[ ! -e $backup ]] || echo "the settings as they were: $backup"
