#!/usr/bin/env bash
# Optional read-only reviewers. Reports are complete files, keyed by reviewed head.
set -uo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

run_one() {
  local main=$1 checkout=$2 report=$3 who=$4 prompt=$5 tool result runtime file cleanup
  case $who in
    claude) tool=(claude -p --model opus --effort high --setting-sources "" --tools Read,Grep,Glob "$prompt") ;;
    cursor) tool=(agent -p "$prompt" --mode ask --trust --output-format text) ;;
    codex) tool=(codex exec --sandbox read-only "$prompt") ;;
  esac
  runtime=$(mktemp -d "${TMPDIR:-/tmp}/workflow-review-$who.XXXXXX") || return 1
  printf -v cleanup 'rm -rf -- %q' "$runtime"
  trap "$cleanup" EXIT
  # Give CLIs their own state and sign-in files, and no session history.
  # The only writable host mount is this temporary home, removed when the process ends.
  for file in .codex/auth.json .codex/config.toml .config/cursor/auth.json .cursor/cli-config.json .claude/.credentials.json .claude.json; do
    [[ -f $HOME/$file ]] || continue
    mkdir -p "$(dirname "$runtime/$file")"
    cp -L "$HOME/$file" "$runtime/$file"
  done
  mkdir -p "$runtime/.cache" "$runtime/.codex" "$runtime/.config" "$runtime/.local/state" "$runtime/tmp"
  # Git metadata and the writer's worktree remain read-only alongside the detached copy.
  env -u WORKFLOW_SESSION -u WORKFLOW_CODEX_BRIDGE -u CLAUDECODE -u CLAUDE_CONFIG_DIR HOME="$runtime" CODEX_HOME="$runtime/.codex" \
    XDG_CONFIG_HOME="$runtime/.config" XDG_CACHE_HOME="$runtime/.cache" \
    XDG_STATE_HOME="$runtime/.local/state" XDG_DATA_HOME="$runtime/.local/share" TMPDIR="$runtime/tmp" timeout 1800 \
    bwrap --ro-bind / / --dev /dev --proc /proc --bind "$runtime" "$runtime" \
    --chdir "$checkout" -- \
    "${tool[@]}" >"$report.pending" 2>&1
  result=$?
  if ((result != 0)); then
    echo "skipped: $who exited unsuccessfully (installation, sign-in, quota or sandbox)" >>"$report.pending"
  fi
  cat "${report%/*}/task-history.md" 2>/dev/null >>"$report.pending"
  echo "exit $result" >>"$report.pending"
  mv "$report.pending" "$report"
  git -C "$main" worktree remove --force "$checkout" >/dev/null 2>&1 || true
}

# The tests a conflict's resolution reaches from `base`, by the repository's selection of one
# kind (`server` or `browser`, its words after the base), given the conflicting files. Without a
# server selection the whole server suite is reached; without a browser one no spec is selected,
# and the task says CI runs the whole browser suite.
select_tests() {
  local kind=$1 base=$2
  shift 2
  if (($# > 0)); then
    "$@" "$base" --files-from .review/conflict-files.txt
  elif [[ $kind == server ]]; then
    jq -n '{whole: true, tests: [], total: 0, reasons: ["no server test selection is configured"]}'
  else
    printf '\nNo browser test selection is configured: CI runs the whole browser suite.\n' >>.review/task.md
  fi
}

number=${1:-}
[[ $number =~ ^[0-9]+$ ]] || { echo "usage: review-panel N [cursor|codex ...]" >&2; exit 2; }
shift
full_review=false
if [[ ${1:-} == --full-review ]]; then
  full_review=true
  shift
fi
reviewers=("$@")
((${#reviewers[@]})) || reviewers=(cursor codex)
for who in "${reviewers[@]}"; do
  [[ $who =~ ^(cursor|codex)$ ]] || exit 2
done
config=$(python3 "$here/workflow_config.py" shell) || exit 1
eval "$config"
# The repository's main checkout, never the checkout these scripts are in.
main=$SHIPLINE_REPO
[[ -n $SHIPLINE_REPOSITORY ]] || { echo "cannot tell which repository to review in" >&2; exit 1; }
cd "$main" || exit 1
task=$(gh pr view "$number" --json title,body,baseRefName,headRefOid) || exit 1
head=$(jq -er .headRefOid <<<"$task") || exit 1
base=$(jq -er .baseRefName <<<"$task") || exit 1
resolver=$(python3 -B "$here/conflict_review.py" program "$main/$SHIPLINE_STATE_FOLDER" "$number") || exit 1
codex_resolved=false
[[ $resolver != codex* ]] || codex_resolved=true
fallback() {
  python3 -B "$here/conflict_review.py" full-review "$main/$SHIPLINE_STATE_FOLDER" "$number" "$head" || exit 1
  echo "Full review required: $1; end without a round, with review finished; the tick starts Claude." >&2
  exit 2
}
if [[ $codex_resolved == true ]]; then
  # Authorship survives a fallback and the next reviewer start, like codex-built-N.
  touch "$main/$SHIPLINE_STATE_FOLDER/codex-resolved-$number"
  [[ $full_review == false ]] || fallback 'explicit --full-review'
  [[ -f $main/$SHIPLINE_STATE_FOLDER/review-$number.conflict.json ]] || fallback 'missing conflict scope'
  # Explicit tool arguments cannot let a resolver review its own resolution.
  reviewers=(claude cursor)
elif [[ -r $main/$SHIPLINE_STATE_FOLDER/review-$number.usual-reviewer &&
        $(cat "$main/$SHIPLINE_STATE_FOLDER/review-$number.usual-reviewer") == "$head" ]]; then
  full_review=true
fi
root=$main/$SHIPLINE_STATE_FOLDER/reviews/$number/$head
[[ $full_review == false ]] || root=$root/full-review
mkdir -p "$root" || exit 1
exec 9>"$root/panel.lock"
flock --nonblock 9 || { echo "panel $number already running: $root"; exit 0; }
git fetch --quiet origin "$head" "$base" main || exit 1
if ! bash "$here/weaker-tests" --base "origin/$base" --head "$head" >"$root/weaker-tests.md.pending"; then
  rm -f "$root/weaker-tests.md.pending"
  echo "could not generate weaker-tests report" >&2
  exit 1
fi
mv "$root/weaker-tests.md.pending" "$root/weaker-tests.md"
python3 "$here/task_history.py" "$number" "$root" <<<"$task" || exit 1
prompt=$(sed -e "s/{N}/$number/g" -e "s|{REPOSITORY}|$SHIPLINE_REPOSITORY|g" "$here/review-prompt.txt")
# Prepare evidence once, even when completed tool reports can be reused.
git diff "origin/$base...$head" >"$root/diff.patch" || exit 1
scope_key=full
if [[ $full_review == false && -f $main/$SHIPLINE_STATE_FOLDER/review-$number.conflict.json ]]; then
  raw_reviews=$(gh api --paginate "repos/$SHIPLINE_REPOSITORY/pulls/$number/reviews") || exit 1
  reviews=$(jq -s 'add' <<<"$raw_reviews") || exit 1
  inputs=$(mktemp -d "$root/inputs.XXXXXX") || exit 1
  git worktree add --quiet --detach "$inputs" "$head" || exit 1
  mkdir -p "$inputs/.review"
  cp "$root/"{diff.patch,task.md,weaker-tests.md} "$inputs/.review/"
  python3 -B "$here/conflict_review.py" panel "$main/$SHIPLINE_STATE_FOLDER" "$number" "$inputs" "$head" <<<"$reviews"
  scope_result=$?
  if ((scope_result == 0)); then
    # The repository's own test selections (`shipline.json`).
    if ! (cd "$inputs" && select_tests server "$head^1" "${SHIPLINE_COMMAND_SERVER_TESTS_FOR_CHANGES[@]}" > .review/server-tests.json &&
        select_tests browser "$head^1" "${SHIPLINE_COMMAND_BROWSER_TESTS_FOR_CHANGES[@]}" > .review/browser-tests.txt); then
      git worktree remove --force "$inputs" >/dev/null 2>&1
      echo "could not select tests for the conflict resolution" >&2
      exit 1
    fi
    cp "$inputs/.review/"{diff.patch,task.md,weaker-tests.md,conflict-files.txt,server-tests.json,browser-tests.txt} "$root/"
    scope_key=$(sha256sum "$root/task.md" "$root/diff.patch" | sha256sum | cut -d' ' -f1)
  elif ((scope_result == 2)); then
    if [[ $codex_resolved == true ]]; then
      git worktree remove --force "$inputs" >/dev/null 2>&1 || exit 1
      fallback 'the panel could not prove the conflict scope'
    fi
    cp "$inputs/.review/task.md" "$root/task.md"
    rm -f "$root/"{conflict-files.txt,server-tests.json,browser-tests.txt}
  else
    git worktree remove --force "$inputs" >/dev/null 2>&1
    echo "could not prepare conflict review evidence" >&2
    exit 1
  fi
  git worktree remove --force "$inputs" >/dev/null 2>&1 || exit 1
fi
pids=()
for who in "${reviewers[@]}"; do
  report=$root/$who.md
  # The reviewer inherits this lock and its own processes keep it, even when a panel that
  # started it was killed. A free lock beside a pending report means that review was abandoned.
  exec 8>"$report.lock"
  if ! flock --nonblock 8; then
    echo "$who review of $head still running"
    continue
  fi
  # A completed report for this exact head can be reused. Checked under the lock, since a
  # surviving reviewer publishes its report before releasing it.
  if [[ -f $report ]]; then
    previous_scope=$(cat "$report.scope" 2>/dev/null || echo full)
    [[ $previous_scope != "$scope_key" ]] || continue
    rm -f "$report"
  fi
  echo "$scope_key" >"$report.scope"
  rm -f "$report.pending"
  installed=false
  case $who in
    claude) command -v claude >/dev/null && installed=true ;;
    cursor) command -v agent >/dev/null && installed=true ;;
    codex) command -v codex >/dev/null && installed=true ;;
  esac
  if [[ $who == codex && -e $main/$SHIPLINE_STATE_FOLDER/codex-built-$number ]]; then
    echo 'skipped: Codex built this pull request' >"$report"
    continue
  fi
  if [[ $who == codex && -e $main/$SHIPLINE_STATE_FOLDER/codex-resolved-$number ]]; then
    echo 'skipped: Codex resolved a conflict on this pull request' >"$report"
    continue
  fi
  if [[ $installed == false ]] || ! command -v bwrap >/dev/null; then
    echo "skipped: $who or its read-only sandbox is not installed" >"$report"
    continue
  fi
  checkout=$(mktemp -d "$root/$who.XXXXXX") || continue
  if ! git worktree add --quiet --detach "$checkout" "$head"; then
    echo "skipped: could not prepare $who checkout" >"$report"
    rmdir "$checkout" 2>/dev/null || true
    continue
  fi
  mkdir -p "$checkout/.review"
  cp "$root/weaker-tests.md" "$checkout/.review/weaker-tests.md"
  cp "$root"/task{,-as-opened,-changes,-history}.md "$checkout/.review/"
  if ! git show origin/main:AGENTS.md >"$checkout/.review/workflow-rules.md"; then
    git worktree remove --force "$checkout" >/dev/null 2>&1
    echo "skipped: could not read workflow rules from main for $who" >"$report"
    continue
  fi
  cp "$root/diff.patch" "$checkout/.review/diff.patch"
  if [[ $scope_key != full ]]; then
    cp "$root/"{conflict-files.txt,server-tests.json,browser-tests.txt} "$checkout/.review/"
  fi
  run_one "$main" "$checkout" "$report" "$who" "$prompt" 9>&- &
  pids+=("$!")
done
exec 8>&-
for pid in "${pids[@]}"; do wait "$pid" || true; done
completed="cursor.md and codex.md"
[[ $codex_resolved == false ]] || completed="claude.md and cursor.md"
echo "panel $number reports: $root (read task-history.md, task-changes.md, weaker-tests.md and completed $completed files only)"
