# Sourced by `install-hooks` and `install-timer`. Where the scripts' checkout keeps its launcher,
# and the link `~/.local/bin/shipline` to it, so `shipline` is found on the owner's PATH.

# Sets home and launcher: the Shipline checkout these scripts are in, and its `bin/shipline`.
find_launcher() {
  home=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
  launcher=$home/bin/shipline
  [[ -f $launcher ]] || {
    echo "$home has no bin/shipline: run this from a checkout of Shipline" >&2
    exit 1
  }
}

# A link that points elsewhere, an older checkout's, is pointed at this one. A file of the
# owner's own at that place is left as it is.
link_launcher() {
  local link=$HOME/.local/bin/shipline
  if [[ -e $link && ! -L $link ]]; then
    echo "$link is not a link to Shipline; it was left as it is" >&2
    return 0
  fi
  [[ $(readlink "$link" 2>/dev/null) != "$launcher" ]] || return 0
  mkdir -p "$(dirname "$link")"
  ln -sfn "$launcher" "$link"
  echo "$link now runs $launcher"
}

# Remember explicit lookup settings before workflow_config.py replaces SHIPLINE_CONFIG with
# the selected path. Timers and hooks must keep the same selection in a fresh environment.
remember_config() {
  named_config=${SHIPLINE_CONFIG:-}
  named_config_home=${XDG_CONFIG_HOME:-}
  if [[ -n $named_config_home && $named_config_home != /* ]]; then
    named_config_home=$PWD/$named_config_home
  fi
}

config_environment() {
  local key value
  for key in SHIPLINE_CONFIG XDG_CONFIG_HOME; do
    if [[ $key == SHIPLINE_CONFIG ]]; then
      [[ -n $named_config ]] || continue
      value=$SHIPLINE_CONFIG
    else
      [[ -n $named_config_home ]] || continue
      value=$named_config_home
    fi
    # Environment= uses systemd's quoted strings, including its percent placeholders.
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    value=${value//$'\n'/\\n}
    value=${value//$'\r'/\\r}
    value=${value//%/%%}
    printf 'Environment="%s=%s"\n' "$key" "$value"
  done
}

config_command_prefix() {
  [[ -z $named_config ]] || printf 'SHIPLINE_CONFIG=%q ' "$SHIPLINE_CONFIG"
  [[ -z $named_config_home ]] || printf 'XDG_CONFIG_HOME=%q ' "$named_config_home"
  return 0
}
