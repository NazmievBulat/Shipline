#!/usr/bin/env bash
# Does the part of the workflow that has one right answer. A systemd user timer runs it every
# 3 minutes (see `install-timer`); there is no model in it, beyond the one that carries a
# message of `wake` to the orchestrator.
#
#   1. An idle audit that said "audit finished" is stopped, and so is an idle worker that said
#      "worker finished", unless its pull request is still a draft, and an idle hunt that said
#      "hunt finished". A hunt that still runs 65 minutes after its start is stopped too. An
#      analyst that said "analysis finished", idle or not, or that still runs 40 minutes after
#      its start, is stopped. A
#      Codex completion is read regardless of its bridge state; a bridge that ended or
#      failed to parse a tool call gets its bridge again while Codex works. A reviewer that
#      said "review finished" on an open, ready pull request based on main without handing
#      its merge to the tick is noted as a rule break for the wake.
#   2. `session cleanup`: the worktrees of merged pull requests and of ended hunts and analysts
#      are removed; an ended analysis is noted for the wake's next check-in first.
#   3. A session that is idle or stopped on the usage limit and holds more than 300 MB is
#      squeezed.
#   4. A worker, independent reviewer or audit that the usage limit stopped is sent its instruction again when
#      the time the limit resets has passed, once for each reset.
#   5. `wake`: the orchestrator session is told of the sessions step 4 woke, and looked in on
#      every 20 minutes at night. This is the one step that may call a model, to deliver the
#      message.
#   6. A labelled draft with no session gets a worker; a ready pull request gets a fresh
#      reviewer. A reviewer that restored draft and said "review sent back" hands back to a
#      worker. A reviewed stack head waits for its base without repeated reviews. Starts go
#      by priority (`priority.jq`), then the older ticket; one that waits for memory keeps
#      the ones after it waiting too.
#   7. A reviewer marked as waiting for checks is woken once per head when all checks finish,
#      even before publishing its round. Without a wait note, an idle reviewer needs a round
#      it published on the head or an earlier commit of it. Owner questions are left alone
#      here.
#      A reviewer or audit whose pull request another member's gate call merged in a batch
#      is told so once, to do its after-merge duties. One that waits for its checks before it
#      joined the merge line is woken once per head for a check GitHub lost, as the gate defines
#      it (`tick_lost_check.py`); an audit's pull request needs no label for that. A lost check
#      beside a failure, before the line or in it, wakes as checks that finished.
#   8. Waits that ended or stalled, for Claude workers and reviewers (never Codex bridges, hunts
#      or audits): a session idle 50 minutes waiting for its own job or its turn in the train
#      is asked once per idle stretch whether the wait is over; a worker idle 15 minutes on a
#      ready pull request without "worker finished" is told once to finish; a busy session
#      whose screen has not changed for 45 minutes (once per stretch and head), and a busy
#      wait loop that finds its own shell (once per loop), are interrupted with Escape, told
#      why and named in the wake. Those two are the only running commands interrupted. An
#      idle session that no rule covers for 50 minutes is named in the wake once per head,
#      and typed nothing. When each screen last changed is noted for `session list`. A
#      question to the owner that its Claude worker, reviewer or audit marked `Owner only: no`
#      gets its recommended reply once it has waited `answer_for_owner_after_minutes` (15),
#      once for the same words, and the wake is told; one without that line, or without a
#      reply word, waits for the owner and is named in the wake once.
#      A cloud worker whose draft had no push and no report for `cloud_wake_after_minutes`,
#      with no open question, is woken once through `claude --cloud` and named in the wake if
#      still quiet that long after; one whose question was answered is woken at once
#      (`cloud_workers.py wake`).
#   9. After the starts of step 6, the next draft without the label gets it when one may start
#      (`ticket_starts.py`: by priority, then the older ticket, when its files overlap no running
#      ticket's, nothing in `start-plan` holds it back, the machine has had room for 10
#      minutes and nothing started for 5), at most one a tick. The next tick starts its worker.
#  10. `workflow-metrics`: every tick takes one sample of the machine and the sessions, from
#      local reads only. Once a day from 07:50 UTC, once GitHub may be asked, it starts the daily
#      run, detached: the report goes to .local/analyses/metrics-<date>.md and its findings to
#      the wake's next check-in.
#  11. From 08:00 UTC, once the day's metrics report is written, one analyst a day
#      (`session start analyst day-<date>`, on Sunday `week-<date>` over 7 days), when the
#      5-hour usage window allows a start: not above 85% unless it resets within the hour.
#  12. `ci_demand.py`: the CI and image jobs the pushes on their way will start within half an
#      hour (working cloud workers, busy local workers and reviewers, ready pull requests whose
#      checks have not started, the merge line's prefixes still to be built), written to
#      ~/.local/state/workflow/ci-demand.json for the runner balancer.
#
# Before all of these, before even the config is read, `self_update.py` keeps Shipline's own
# checkout current: it moves it to Shipline's `main` once that commit's CI passed, or back to
# the last good commit when the new one crashed 3 times in a row. When it moved, the tick runs
# again from the start as the version now checked out. Each tick's end is counted on the
# version it started on: a crash is an exit other than 0 or 1, or a traceback or an error of the
# shell in what the tick and its steps print to standard error, which passes through
# `self_update.py watch` on its way.
#
# Steps 1 and 2 are the one place a session is closed, and only when its work no longer exists.
# The starts come last because the steps before them may free memory they need.
# Audits are not started here: the orchestrator session starts one by hand, and only for a
# pull request that was built before the workflow existed. Hunts are not started here either.
# The daily analyst is: it reads the logs and the metrics report, and asks the owner nothing.
#
# `tick --shadow` (`shipline tick --shadow`) takes the same decisions and carries out none: no push,
# no label, no merge, no message, no session started, stopped or typed into, and no note of the
# tick, the gate or the wake written. It runs beside an installation that still runs its own copy of
# the scripts, on a timer of its own 75 seconds before that installation's own tick, ending before
# it starts, and shows whether Shipline decides as that copy does (`tools/compare-shadow`). It stops
# itself after SHADOW_SECONDS and logs that it was cut short. What is not yet due but comes due
# within SHADOW_AHEAD_SECONDS, before the next shadow tick, it logs as `due within 180 s:
# <decision>`, the decision the real tick between the two may take alone; so does its wake. Each
# decision is one line of `.local/shipline/shadow.log` in the main checkout, in the words the real
# tick logs it in: the wake log's for the nudges, the session command's for a stop, a squeeze, a
# resend, a bridge and a start (without its link or figures), and the wake's check-in. It reads all
# the real tick reads, the merge line as last saved (the gate's read path, without its lock), and
# notes the train status whenever it changed. It does not run what only carries decisions out or
# keeps records: the metrics, the cloud workers' poll and wake, the worktree cleanup (it only
# drops from its list the sessions cleanup stops, of a pull request closed without merging),
# main's report, the merge driver, the automatic ticket start and the CI demand forecast. A start
# is logged when `session start` would make it: no session of its pull request running, room for
# it, and for a reviewer the checks of
# `reviewer_start.py` (and of the merge driver, for a hand-back's). Its own lock keeps a second
# shadow tick out, and never the real one, nor a decision of `decide`.
set -uo pipefail

# A session that holds more than this while idle is squeezed.
SQUEEZE_ABOVE_MB=300
# The usage limit counts over 5 hours, so the time on a limit line is at most this far ahead.
LIMIT_WINDOW_SECONDS=$((5 * 3600))
HALF_A_YEAR_SECONDS=$((182 * 86400))
ZONES=${WORKFLOW_ZONES:-/usr/share/zoneinfo}
# The time now, in seconds. A test names another.
NOW=${WORKFLOW_NOW:-$(date +%s)}
# A hunter hunts for 45 minutes and then writes its report. One that still runs after this
# many is stuck, or a Codex hunter that never ended; nothing else would stop it.
HUNT_STOPPED_AFTER_MINUTES=65
# An analyst has 40 minutes to read the logs and publish its report.
ANALYST_STOPPED_AFTER_MINUTES=40
# A session waiting for its own job or its turn loses its cached context an hour after its last
# turn; one this long idle is asked whether the wait is over. One message per idle stretch.
KEEP_ALIVE_AFTER_SECONDS=$((50 * 60))
# A worker idle this long with its pull request ready, and no "worker finished", is told once.
READY_UNFINISHED_SECONDS=$((15 * 60))
# A busy session whose screen has not changed for this long is nudged and named in the wake, once.
STUCK_AFTER_SECONDS=$((45 * 60))
# A busy session's wait loop that finds itself is nudged once its screen has stood still this long;
# while the screen moves, it is named without a nudge after the second.
LOOP_STILL_SECONDS=$((5 * 60))
LOOP_NAMED_AFTER_SECONDS=$((15 * 60))
# How many more times a nudge whose Enter was not taken is sent again.
NUDGE_RETRIES=3
# An idle session that no rule covers is named in the wake after this long, once per head.
IDLE_NO_RULE_SECONDS=$((50 * 60))
# The line a session ends with, WORDS standing for its words. `notify` reads it the same way.
FINISHED_LINE='^[[:space:]]*(●|[*-])?[[:space:]]*[*_]*WORDS[.!]?[*_]*[[:space:]]*$'
# The time of day, UTC, from which the daily metrics run starts; empty, it never does. A test
# names another.
METRICS_DAILY_AT=${WORKFLOW_METRICS_DAILY_AT-07:50}
# The time of day, UTC, from which the daily analyst starts, after the metrics run; empty, it
# never does. A test names another.
ANALYST_DAILY_AT=${WORKFLOW_ANALYST_DAILY_AT-08:00}
# The 5-hour usage window above which, unless it resets within the hour, nothing starts.
USAGE_CEILING=85

# A shadow tick starts this many seconds before the real tick (its timer, in the README), and ends
# after SHADOW_SECONDS, whatever it waits for, well before the real tick starts. A test names
# another bound.
SHADOW_LEAD_SECONDS=75
SHADOW_SECONDS=${WORKFLOW_SHADOW_SECONDS:-60}
# How far past its own clock a shadow tick looks for what comes due: until the next shadow tick,
# as the real tick between the two reads its clock later.
SHADOW_AHEAD_SECONDS=180

shadow=0
if (($#)); then
  if [[ $# -ne 1 || $1 != --shadow ]]; then
    echo "usage: tick [--shadow]" >&2
    exit 2
  fi
  shadow=1
fi

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# Every program a shadow tick starts changes nothing while SHIPLINE_SHADOW names its log, set
# once the tick holds its lock; a real tick gives them none.
unset SHIPLINE_SHADOW SHIPLINE_SHADOW_NOTES
# A self-update that cannot be done leaves the tick to go on as it is. One move a tick: the
# tick that runs again after it moves nothing. A shadow tick neither moves Shipline's checkout
# nor counts its own end: it is not the tick of the repository it reads.
# Set when this tick only found the one before it still running: it counts neither way.
tick_skipped=""
tick_watched=""
if ((shadow == 0)); then
  moved=${SHIPLINE_TICK_MOVED:-}
  unset SHIPLINE_TICK_MOVED
  python3 -B "$here/self_update.py" start "$$" ${moved:+moved}
  kept=$?
  if ((kept == 10)) && [[ -z $moved ]]; then
    SHIPLINE_TICK_MOVED=1 exec bash "$here/tick" "$@"
  fi
  # 12: the self-update crashed itself, which this tick's end counts.
  if ((kept == 0 || kept == 10 || kept == 12)); then
    tick_watched=watched
    exec 7>&2 2> >(python3 -B "$here/self_update.py" watch "$$" 2>&7 >&7 7>&-)
  fi
fi
tick_ended() {
  ((shadow == 0)) || return 0
  if [[ -n $tick_watched ]]; then
    # Everything printed before this line was read; what follows goes straight out. A watch
    # that is gone must not end the tick before its end is counted.
    trap '' PIPE
    printf 'shipline-tick-ended %s\n' "$$" >&2
    exec 2>&7 7>&-
  fi
  python3 -B "$here/self_update.py" end "$$" "$1" $tick_skipped $tick_watched 9>&- || true
}
trap 'tick_ended $?' EXIT
# A tick that is stopped exits as stopped, not with the status of its last command.
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
gh() { python3 "$here/github_budget.py" call tick "$@"; }
source "$here/bridge-failed"
# The repository, its check names, labels and state folder (`workflow_config.py`), read once.
config=$(python3 "$here/workflow_config.py" shell) || exit 1
eval "$config"
if [[ -z $SHIPLINE_REPOSITORY ]]; then
  echo "cannot tell which repository the workflow works on: shipline.json names none," \
    ".github/runner/settings.sh is missing or names none, and origin names no GitHub" \
    "repository" >&2
  exit 1
fi
# priority.jq reads the label names from it.
export SHIPLINE_CONFIG
# The repository's main checkout (`SHIPLINE_REPO`, else the one of the current folder), never
# the checkout these scripts are in.
main=$SHIPLINE_REPO
common=$(git -C "$main" rev-parse --path-format=absolute --git-common-dir) || exit 1
# What the tick and the gate ask git, they ask of the repository, whichever folder ran it.
cd "$main" || exit 1

# A shadow tick runs under its own bound, as a tick of its own beside the real one: at its end it
# is stopped, and its log says so, so that `compare-shadow` leaves out the real tick beside it.
if ((shadow)) && [[ -z ${SHIPLINE_SHADOW_BOUND:-} ]]; then
  SECONDS=0
  SHIPLINE_SHADOW_BOUND=$NOW timeout --kill-after=2 "$SHADOW_SECONDS" bash "$here/tick" --shadow
  status=$?
  log=$main/.local/shipline/shadow.log
  # 124 when the bound stopped it, 137 when it had to be killed after that.
  if ((status == 124 || (status == 137 && SECONDS >= SHADOW_SECONDS))) &&
      [[ -f $log && ! -L $log ]]; then
    printf '%s shadow tick cut short after %s s\n' "$NOW" "$SHADOW_SECONDS" >>"$log"
  fi
  exit "$status"
fi
# The bounded tick reads the clock as the one that started it.
if ((shadow)); then
  [[ $SHIPLINE_SHADOW_BOUND =~ ^[0-9]+$ ]] || { echo "SHIPLINE_SHADOW_BOUND is no time" >&2; exit 2; }
  NOW=$SHIPLINE_SHADOW_BOUND
  unset SHIPLINE_SHADOW_BOUND
  # Stopped at its bound, it still removes what it made.
  trap 'exit 143' TERM
fi

# A second tick exits while the first still runs. The lock is in the git common directory, where
# no change of shipline.json moves it: a tick that reads a new state folder still waits for one
# that read the old. A shadow tick has a lock of its own.
if ((shadow)); then
  exec 9>"$common/shipline-shadow.lock"
  if ! flock --nonblock 9; then
    echo "the shadow tick before this one is still running"
    exit 0
  fi
  # The log holds the names and the heads of the work: for its owner alone, and never written
  # through a link.
  export SHIPLINE_SHADOW=$main/.local/shipline/shadow.log
  if [[ -L $SHIPLINE_SHADOW ]]; then
    echo "$SHIPLINE_SHADOW is a link; a shadow tick writes no file through it" >&2
    exit 1
  fi
  (umask 077 && mkdir -p "${SHIPLINE_SHADOW%/*}" && : >>"$SHIPLINE_SHADOW") || exit 1
  # Git takes no lock it can do without, such as the index's in a session's worktree.
  export GIT_OPTIONAL_LOCKS=0
  # The wake looks as far ahead as the tick (`shadow_due`), and knows the earliest the real
  # tick reads its clock.
  export SHIPLINE_SHADOW_AHEAD=$SHADOW_AHEAD_SECONDS
  export SHIPLINE_SHADOW_REAL_FROM=$((NOW + SHADOW_LEAD_SECONDS))
else
  mkdir -p "$main/$SHIPLINE_STATE_FOLDER"
  exec 9>"$common/shipline-tick.lock"
  if ! flock --nonblock 9; then
    echo "the tick before this one is still running"
    tick_skipped=skipped
    exit 0
  fi
fi

# A start the tick makes, directly or through the merge driver, does not wait for memory while
# the tick holds its lock: it is left for the next tick, so later ticks still do their work.
export WORKFLOW_DEFER_START=1
export WORKFLOW_TRAIN_TICK
WORKFLOW_TRAIN_TICK=$(mktemp -d)
export WORKFLOW_SESSION_SNAPSHOT=$WORKFLOW_TRAIN_TICK/sessions
python3 -c 'import json,sys,time; json.dump({"started": time.time()}, open(sys.argv[1], "w"))' "$WORKFLOW_TRAIN_TICK/context.json"
trap 'tick_code=$?; rm -rf "$WORKFLOW_TRAIN_TICK"; tick_ended "$tick_code"' EXIT

# A decision of a shadow tick: a line of its log.
shadow_note() {
  printf '%s %s\n' "$NOW" "$*" >>"$SHIPLINE_SHADOW"
}
# What a shadow tick finds not yet due, but due within SHADOW_AHEAD_SECONDS, before the next
# shadow tick: the decision the real tick between the two, which reads its clock later, may take
# alone, in its own words, on a line `compare-shadow` reads as the reason. Given the seconds
# until it comes due.
shadow_due() {
  local until=$1
  shift
  ((shadow && until > 0 && until <= SHADOW_AHEAD_SECONDS)) || return 0
  shadow_note "due within $until s: $*"
}
# The seconds until a hunt or an analyst runs over its time, by the clock `find` reads.
over_in() {
  local started=$main/.claude/worktrees/$1/$SHIPLINE_STATE_FOLDER/$1.started at
  at=$(stat -c %Y "$started" 2>/dev/null) || return 1
  echo $((at + $2 * 60 - $(date +%s)))
}
shadow_over_due() {
  local until
  until=$(over_in "$1" "$2") || return 0
  shadow_due "$until" "$1 is over its time"
  shadow_due "$until" "$1 stopped"
}

# What the tick says it does: on its output, and in a shadow tick in its log.
say() {
  if ((shadow)); then shadow_note "$*"; else echo "$*"; fi
}
# A note the tick reads again in a later tick. A shadow tick leaves the real tick's notes as
# they are, and keeps none of its own.
keep() {
  ((shadow)) || printf '%s\n' "$2" >"$1"
}
# The tick's line of the wake log; a shadow tick's goes to its own log.
wake_log() {
  local log=$HOME/.local/state/workflow/wake.log
  if ((shadow)); then
    shadow_note "$*"
    return
  fi
  mkdir -p "${log%/*}" && printf '%s %s\n' "$NOW" "$*" >>"$log"
}
if ((shadow)); then
  # The notes the shadow tick takes for its own wake, which reads them beside the real ones.
  export SHIPLINE_SHADOW_NOTES=$WORKFLOW_TRAIN_TICK/shadow-notes
  shadow_note "shadow tick"
  # A real tick that still runs from its last start may write the marks this one reads, and
  # takes the decisions of its next start too: this shadow tick takes none, and says so, and
  # `compare-shadow` leaves out the real decisions beside it. SHIPLINE_SHADOW_BESIDE names the
  # real tick's service (the README sets it), a oneshot that is `activating` while it runs; a
  # state that cannot be read skips the tick too.
  beside=${SHIPLINE_SHADOW_BESIDE:-}
  if [[ -n $beside ]]; then
    [[ $beside =~ ^[A-Za-z0-9@._-]+$ ]] || { echo "SHIPLINE_SHADOW_BESIDE is no unit" >&2; exit 2; }
    beside_state=$(systemctl --user show -p ActiveState --value "$beside" 2>/dev/null 9>&-) ||
      beside_state=unreadable
    if [[ ! $beside_state =~ ^(inactive|failed)$ ]]; then
      shadow_note "shadow tick skipped: $beside is ${beside_state:-unreadable}"
      exit 0
    fi
  fi
fi

# The tick's list of sessions, kept in step with what a shadow tick would start and stop, as
# the session command keeps it for the real tick.
snapshot_drop() {
  [[ -f $WORKFLOW_SESSION_SNAPSHOT ]] || return 0
  awk -v name="$1" -v twin="$2" '$1 != name && $1 != twin' \
    "$WORKFLOW_SESSION_SNAPSHOT" >"$WORKFLOW_SESSION_SNAPSHOT.pending" &&
    mv "$WORKFLOW_SESSION_SNAPSHOT.pending" "$WORKFLOW_SESSION_SNAPSHOT"
}
snapshot_busy() {
  [[ -f $WORKFLOW_SESSION_SNAPSHOT ]] || return 0
  awk -v name="$1" '
    $1 == name { $2="busy"; print; found=1; next }
    { print }
    END { if (!found) print name " busy ? held, ? swap" }
  ' "$WORKFLOW_SESSION_SNAPSHOT" >"$WORKFLOW_SESSION_SNAPSHOT.pending" &&
    mv "$WORKFLOW_SESSION_SNAPSHOT.pending" "$WORKFLOW_SESSION_SNAPSHOT"
}

# Whether a session runs, as a shadow tick would have left it: what it stopped does not, what it
# started does, and the others as `tmux` finds them.
shadow_stopped=" "
shadow_started=" "
shadow_alive() {
  [[ $shadow_stopped != *" $1 "* ]] || return 1
  [[ $shadow_started != *" $1 "* ]] || return 0
  tmux -L "$1" has-session -t "=$1" 2>/dev/null 9>&-
}

# A start of a shadow tick, logged when `session start` would make it: none while a session of
# the pull request runs, which it refuses; with room for it, as `session room` reads it, or 75
# as when it waits. A cloud worker needs no room here.
shadow_start() {
  local kind=$1 number=$2 program=${3:-} name room other
  case $kind in
    worker) name=ticket-$number ;;
    review) name=review-$number ;;
    *) name=$kind-$number ;;
  esac
  [[ $program != cloud ]] || name=cloud-$number
  for other in ticket audit review codex cloud; do
    ! shadow_alive "$other-$number" || return 1
  done
  if [[ $program != cloud ]] && ! room=$(bash "$here/session" room 2>&1 9>&-); then
    shadow_note "$room; the next tick tries this start again"
    return 75
  fi
  shadow_note "$name started"
  shadow_started+="$name "
  snapshot_busy "$name"
}

# A hand-back's reviewer in a shadow tick, started as the merge driver starts it
# (`merge_driver.py --start-hand-back`), read only: none while a session of its pull request
# runs, none unless the pull request is open, ready and labelled, and none that the checks of
# `reviewer_start.py` hold back, as for a ready pull request below. Its rounds are read the same.
shadow_hand_back() {
  local number=$1 other pull reviews history round sent_back
  for other in ticket audit review codex cloud; do
    ! shadow_alive "$other-$number" || return 0
  done
  grep -qE "^$number false " <<<"$pulls" || return 0
  pull=$(python3 "$here/tick_snapshot.py" view "$snapshot" "$number" 9>&-) || return 1
  reviews=$(gh api --paginate "repos/$SHIPLINE_REPOSITORY/pulls/$number/reviews" 9>&-) || return 1
  history=$(jq -scr '[.[][] | (.body // "") |
    capture("^<!-- workflow-review round=(?<round>[0-9]+)( result=(?<result>sent-back|passed))? -->")? |
    {round: (.round | tonumber), result: (.result // "sent-back")}] |
    [(map(.round) | max // 0), (map(select(.result == "sent-back")) | length)] | @tsv' <<<"$reviews") ||
    return 1
  read -r round sent_back <<<"$history"
  python3 -B "$here/reviewer_start.py" --shadow "$main/$SHIPLINE_STATE_FOLDER" "$number" \
    "$(jq -r '.headRefOid' <<<"$pull")" "$((round + 1))" "$sent_back" \
    "$(jq -r '.headRefName' <<<"$pull")" 9>&- || return 0
  shadow_start review "$number"
}

# Whether `session nudge-busy` would press anything in the session now (`session would-nudge`).
shadow_would_nudge() {
  bash "$here/session" would-nudge "$@" >/dev/null 2>&1 9>&-
}

# What `session cleanup` decides beside removing worktrees: it stops the sessions of a pull
# request closed without merging. They leave the tick's list, as they do in the real tick.
shadow_cleanup() {
  local path number state session
  [[ -n ${WORKFLOW_PR_SNAPSHOT:-} ]] || return 0
  while IFS= read -r path; do
    [[ ${path%/*} == "$main/.claude/worktrees" && ${path##*/} =~ ^ticket-([0-9]+)$ ]] || continue
    number=${BASH_REMATCH[1]}
    [[ ! -e $main/$SHIPLINE_STATE_FOLDER/merge-wanted-$number ]] || continue
    state=$(python3 "$here/tick_snapshot.py" view "$WORKFLOW_PR_SNAPSHOT" "$number" 9>&- |
      jq -r '.state') || continue
    [[ $state != OPEN && $state != MERGED ]] || continue
    for session in "ticket-$number" "audit-$number" "review-$number"; do
      shadow_stopped+="$session "
      snapshot_drop "$session" "codex-$number"
    done
  done < <(git -C "$main" worktree list --porcelain 9>&- | sed -n 's/^worktree //p')
}

# A shadow tick reads the sessions and logs what it would make of them, in the words the
# session command prints when it does it.
shadow_session() {
  case $1 in
    list | running | load | room) bash "$here/session" "$@" 9>&- ;;
    stop)
      # One that runs no more is left as it is: `session stop` says so, and stops nothing.
      shadow_alive "$2" || { [[ $2 == ticket-* ]] && shadow_alive "codex-${2#ticket-}"; } ||
        return 0
      shadow_note "$2 stopped"
      shadow_stopped+="$2 codex-${2#ticket-} "
      snapshot_drop "$2" "codex-${2#ticket-}"
      ;;
    squeeze) shadow_note "$2 squeezed" ;;
    resend)
      shadow_note "$2 was sent its instruction again"
      snapshot_busy "$2"
      ;;
    bridge)
      # The new bridge prints its start, as any session does, before the bridge says so.
      shadow_note "$2 started"
      shadow_note "$2: its bridge was started again"
      snapshot_busy "$2"
      ;;
    start) shadow_start "$2" "$3" "${5:-}" ;;
    # The worktrees of finished work stay: removing them decides nothing the real tick logs.
    cleanup) [[ ${2:-} == hunts ]] || shadow_cleanup ;;
    # The tick itself logs each message it would have typed, in the wake log's words.
    checks-finished | conflict-found | lost-check | batch-merged | status-check | finish-ready) ;;
    # A nudge goes as `session nudge-busy` would send it, pressing nothing: it presses nothing
    # either in the states it checks (exit 3).
    nudge-busy) bash "$here/session" would-nudge "${@:2}" 9>&- ;;
    # An answer for the owner too, as `session answer-for-owner` would type it.
    answer-for-owner) bash "$here/session" would-answer "${@:2}" 9>&- ;;
    *) shadow_note "session $*" ;;
  esac
}

# The lock is closed for everything the tick calls: a `tmux` server started here lives on
# after the tick, and would hold the lock for as long as its session runs.
session() {
  if ((shadow)); then
    shadow_session "$@"
  else
    bash "$here/session" "$@" 9>&- 8>&- 7>&-
  fi
}

# A cached list can outlive a stop or cleanup. Such a session is no longer busy and
# needs no note; a missing state folder must not be made again by these passes.
session_current() {
  [[ -d $main/$SHIPLINE_STATE_FOLDER ]] || return 1
  tmux -L "$1" has-session -t "=$1" 2>/dev/null 9>&- || {
    [[ $1 == ticket-* ]] &&
      tmux -L "codex-${1#ticket-}" has-session -t "=codex-${1#ticket-}" 2>/dev/null 9>&-
  }
}

# Check again at the write, including after a failed write: cleanup may have run since
# the screen or message was read. Other write errors still fail the tick.
write_session_note() {
  local name=$1 note=$2 text=$3
  session_current "$name" && [[ -d ${note%/*} ]] || return 0
  keep "$note" "$text" || [[ ! -d ${note%/*} ]] || ! session_current "$name"
}

# An audit ends with "audit finished", a worker with "worker finished", a hunt with "hunt
# finished", an analyst with "analysis finished". The words count only
# on a line of their own: after the bullet Claude draws, in bold or not, with a full stop or
# not. With anything else on the line the session is talking about finishing or quoting the
# rule, and after `>` it is quoting or it is what the owner typed.
#
# They count only as the end of the last reply. Between them and the box the owner types in
# (it begins with a rule drawn from the left edge) there may be empty lines, an empty prompt,
# and the lines Claude draws itself after a turn, which start with one of its own marks.
# Anything else there is more of the reply, an instruction given after it, or a newer reply:
# the session went on, perhaps to ask something.
# What is under the box is not read: the list of agents there has bullets of its own.
#
# Read byte by byte, so that it is the same under any locale. The screen is read whole before
# it is searched: `grep -q` leaves at the first match, and in a pipe that can end `tmux` with
# an error, which `pipefail` would report as the words not being there.
said_finished() {
  local screen said after notes pattern=$FINISHED_LINE words="audit finished"
  [[ $1 != review-* ]] || words="review finished"
  [[ $1 != ticket-* ]] || words="worker finished"
  [[ $1 != hunt-* ]] || words="hunt finished"
  [[ $1 != analyst-* ]] || words="analysis finished"
  words=${2:-$words}
  notes=$main/.claude/worktrees/$1/$SHIPLINE_STATE_FOLDER/$1
  if [[ $1 == ticket-* && -e $notes.codex ]]; then
    # An answered turn is no longer the current work, even before its successor ends.
    [[ ! -e $notes.owner-reply ]] || return 1
    if [[ -r $notes.codex-turn.json ]]; then
      ! cmp -s "$notes.codex-turn.json" "$notes.codex-answered" || return 1
      ! cmp -s "$notes.codex-turn.json" "$notes.codex-followed-up" || return 1
      # A valid latest turn is authoritative, including one that did not finish.
      if jq -e '.["last-assistant-message"] | type == "string"' \
          "$notes.codex-turn.json" >/dev/null 2>&1; then
        said=$(jq -r '.["last-assistant-message"] | split("\n") |
          map(select(test("\\S"))) | last // ""' "$notes.codex-turn.json") || return 1
        LC_ALL=C grep -qiE "${FINISHED_LINE/WORDS/$words}" <<<"$said"
        return $?
      fi
    fi
    # Older workers may have no recorded turn. Only bridges get this tolerance.
    pattern="^[[:space:]]*(●|[*-])?[[:space:]]*(Codex says:[[:space:]]*)?(\"|“|')?[*_]*WORDS[.!]?[*_]*(\"|”|')?[[:space:]]*$"
  fi
  screen=$(tmux -L "$1" capture-pane -p -t "=$1:" 2>/dev/null 9>&-) || return 1
  said=$(LC_ALL=C grep -niE "${pattern/WORDS/$words}" <<<"$screen") || return 1
  said=${said##*$'\n'}
  after=$(LC_ALL=C sed -n "$((${said%%:*} + 1)),\$p" <<<"$screen" | LC_ALL=C sed '/^─/,$d')
  ! LC_ALL=C grep -qvE '^([[:space:]]*((·|✢|✳|✶|✻|✽|⎿).*)?|(>|❯)[[:space:]]*)$' <<<"$after"
}

# Older hooks may have failed to deliver their phone push and left no block note. Read
# only the latest reply above the input box. A question is a line ending in "?" or the words
# to type back ('write "merge it"', "write 1 or 2"); a wait that only names the owner is not.
asks_owner() {
  local screen message top
  screen=$(tmux -L "$1" capture-pane -p -t "=$1:" 2>/dev/null 9>&-) || return 0
  top=$(LC_ALL=C awk '/^─/ { above = last; last = NR } END { print above + 0 }' <<<"$screen")
  ((top > 0)) || return 0
  message=$(LC_ALL=C sed -n "1,$((top - 1))p" <<<"$screen" | LC_ALL=C awk '
    /^[[:space:]]*●/ { reply = "" }
    { reply = reply $0 "\n" }
    END { printf "%s", reply }
  ')
  # The words to type back may be in bold ("Reply **1**"); "reply with" and "choose" ask as in
  # `notify`, which reads the same reply on a stop.
  LC_ALL=C grep -qiE '\?([[:space:]"'"'"')*_`]|”|’)*$|(^|[^[:alpha:]])((write|type|reply|say|answer|choose)[[:space:]]+[*_]*("|“|‘|'"'"'|`|[0-9])|reply[[:space:]]+with([^[:alnum:]]|$))' <<<"$message"
}

# The open pull requests labelled `workflow`: number, true for a draft, and base branch.
list_pull_requests() {
  gh pr list --label "$SHIPLINE_LABEL_WORKFLOW" --state open --limit 1000 --json number,isDraft,baseRefName \
    --jq '.[] | "\(.number) \(.isDraft) \(.baseRefName)"' 9>&-
}

# A reviewer hands every passed review to the tick (`merge-when-current --handoff N`). One that
# said "review finished" while its pull request is still open, ready and based on main, with
# neither a merge note nor a hand-back, broke that rule: the wake tells the orchestrator, once
# for each session and head. GitHub is asked again, as the reviewer may have merged since the
# snapshot.
note_rule_break() {
  local number=$1 folder=$main/$SHIPLINE_STATE_FOLDER state head event notes
  [[ ! -e $folder/merge-wanted-$number && ! -e $folder/merge-review-$number &&
     ! -e $folder/batch-merged-$number ]] || return 0
  read -r state _ head < <(gh pr view "$number" --json state,headRefName,headRefOid \
    --jq '"\(.state) \(.headRefName) \(.headRefOid)"' 9>&-) || return 1
  [[ $state == OPEN && $head =~ ^[0-9a-f]{40}$ ]] || return 0
  event=review-$number-$head.json
  [[ ! -e $folder/rule-breaks.pending/$event && ! -e $folder/rule-breaks.sent/$event ]] ||
    return 0
  notes=$folder/rule-breaks.pending
  ((shadow == 0)) || notes=$SHIPLINE_SHADOW_NOTES/rule-breaks.pending
  mkdir -p "$notes" &&
    jq -n --arg name "review-$number" --arg number "$number" --arg head "$head" \
      '{name: $name, number: $number, head: $head}' >"$notes/.$event.tmp" &&
    mv -- "$notes/.$event.tmp" "$notes/$event"
}

# Read from the time written on the note `session start hunt` or `analyst` leaves.
is_over_its_time() {
  local started=$main/.claude/worktrees/$1/$SHIPLINE_STATE_FOLDER/$1.started
  [[ -n $(find "$started" -mmin "+$2" 2>/dev/null) ]]
}

# Whether the 5-hour usage window allows a start: not above the ceiling, unless it resets
# within the hour. A window that cannot be read allows none. Says why not.
usage_allows_start() {
  local window percent at
  while read -r window percent at; do
    [[ $window == five_hour && $percent =~ ^[0-9]+$ && $at =~ ^[0-9]+$ ]] || continue
    ((percent <= USAGE_CEILING || at - NOW <= 3600)) && return 0
    echo "the 5-hour usage window is $percent% used"
    return 1
  done < <(bash "$here/usage" 2>/dev/null 9>&-)
  echo "the 5-hour usage window could not be read"
  return 1
}

# One analyst a day, from ANALYST_DAILY_AT, once the day's metrics report is written: it reads
# that report. Its report folder says it started; a start that waits for memory is left for the
# next tick, as is one the usage window holds, one within 5 minutes of another start, whose
# memory and load have not shown yet, and one refused for a reason that passes (exit 75: memory,
# another start's lock, a fetch that failed). A start that failed otherwise is not tried again
# that day; a session it left is noted for the wake as an analysis without its report.
start_daily_analyst() {
  local day name=day days=1 why last=0 failed_mark at due=0
  [[ $ANALYST_DAILY_AT =~ ^([0-9]{2}):([0-9]{2})$ ]] || return 0
  if ! ((10#$(date -u -d "@$NOW" +%H%M) >= 10#${BASH_REMATCH[1]}${BASH_REMATCH[2]})); then
    # A shadow tick notes the start that comes due before the next one (`shadow_due`).
    ((shadow)) || return 0
    at=$(date -u -d "$(date -u -d "@$NOW" +%F) ${BASH_REMATCH[1]}:${BASH_REMATCH[2]}" +%s) ||
      return 0
    due=$((at - NOW))
    ((due > 0 && due <= SHADOW_AHEAD_SECONDS)) || return 0
  fi
  day=$(date -u -d "@$NOW" +%F)
  [[ -e $main/.local/analyses/metrics-$day.md ]] || return 0
  if [[ $(date -u -d "@$NOW" +%u) == 7 ]]; then
    name=week
    days=7
  fi
  name=$name-$day
  failed_mark=$main/$SHIPLINE_STATE_FOLDER/analyst-$name.failed
  [[ ! -e $main/.local/analyses/$name && ! -e $failed_mark ]] || return 0
  [[ ! -r $main/$SHIPLINE_STATE_FOLDER/last-start ]] ||
    read -r last _ <"$main/$SHIPLINE_STATE_FOLDER/last-start" || true
  [[ $last =~ ^[0-9]+$ ]] || last=0
  if ((due)); then
    # As the tick at the start time will find it: held by a start in the 5 minutes before, by
    # the usage window, or started.
    if ((at - last < 5 * 60)); then
      shadow_due "$due" "the daily analyst waits: a session started in the last 5 minutes"
      usage_allows_start >/dev/null && shadow_due $((last + 5 * 60 - NOW)) "analyst-$name started"
    elif ! why=$(usage_allows_start); then
      shadow_due "$due" "the daily analyst waits: $why"
    else
      shadow_due "$due" "analyst-$name started"
    fi
    return 0
  fi
  if ((NOW - last < 5 * 60)); then
    say "the daily analyst waits: a session started in the last 5 minutes"
    ((shadow)) && usage_allows_start >/dev/null &&
      shadow_due $((last + 5 * 60 - NOW)) "analyst-$name started"
    return 0
  fi
  if ! why=$(usage_allows_start); then
    say "the daily analyst waits: $why"
    return 0
  fi
  session start analyst "$name" "$days"
  case $? in
    0 | 75) ;;
    *)
      ((shadow)) || touch "$failed_mark"
      return 1
      ;;
  esac
}

# Whether the time a limit line names has passed: "4:10pm", "4pm (America/New_York)" or, with
# its day, "Oct 15, 1am (America/New_York)" and "Jan 2, 2027, 1am". The zone is the one on the
# line, or the machine's when the line has none. Sets reset_at to that moment, in seconds.
#
# A time without a day is read only for the session limit, which counts over 5 hours: it is
# still ahead only when that hour comes within the next 5 hours; further ahead than that, it
# was earlier today or yesterday. Another limit (the weekly one, a model's) names only the
# hour when it resets within a day. session supplies the dated reset from usage when its
# clock agrees with that hour; an unresolved line still says nothing about the day.
# A time that cannot be read has not passed: the session then waits for the orchestrator.
reset_has_passed() {
  local limit=$1 text=$2 zone="" clock='(1[0-2]|0?[1-9])(:[0-5][0-9])?[ap]m' day="" at
  local -a in_zone=()
  if [[ $text =~ ^(.*[^[:space:]])[[:space:]]*\(([A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*)\)$ ]]; then
    text=${BASH_REMATCH[1]}
    zone=${BASH_REMATCH[2]}
    [[ -f $ZONES/$zone ]] || return 1
    in_zone=(env "TZ=$zone")
  fi
  if [[ $text =~ ^([A-Z][a-z]{2})\ ([0-9]{1,2}),?(\ ([0-9]{4}),?)?\ ($clock)$ ]]; then
    local year=${BASH_REMATCH[4]} hour=${BASH_REMATCH[5]}
    day="${BASH_REMATCH[2]} ${BASH_REMATCH[1]}"
    if [[ -n $year ]]; then
      at=$("${in_zone[@]}" date -d "$day $year $hour" +%s 2>/dev/null) || return 1
    else
      # Without its year the day is of this year, or, read in December for January, of the
      # next: a reset is never half a year back.
      year=$("${in_zone[@]}" date -d "@$NOW" +%Y)
      at=$("${in_zone[@]}" date -d "$day $year $hour" +%s 2>/dev/null) || return 1
      ((NOW - at < HALF_A_YEAR_SECONDS)) ||
        at=$("${in_zone[@]}" date -d "$day $((year + 1)) $hour" +%s 2>/dev/null) || return 1
    fi
  elif [[ $limit == "session limit" && $text =~ ^$clock$ ]]; then
    local noon other
    day=$("${in_zone[@]}" date -d "@$NOW" +%F)
    at=$("${in_zone[@]}" date -d "$day $text" +%s 2>/dev/null) || return 1
    # The hour meant is the one that comes within the next 5 hours, today or after midnight;
    # when none does, the last one that passed. The day before and the day after are found
    # from noon, and the hour is read on that day: a day the clocks change is not 24 hours.
    noon=$("${in_zone[@]}" date -d "$day 12:00" +%s) || return 1
    if ((at > NOW)); then
      other=$("${in_zone[@]}" date -d "@$((noon - 86400))" +%F)
      ((at - NOW <= LIMIT_WINDOW_SECONDS)) ||
        at=$("${in_zone[@]}" date -d "$other $text" +%s 2>/dev/null) || return 1
    else
      other=$("${in_zone[@]}" date -d "@$((noon + 86400))" +%F)
      other=$("${in_zone[@]}" date -d "$other $text" +%s 2>/dev/null) || return 1
      ((other - NOW > LIMIT_WINDOW_SECONDS)) || at=$other
    fi
  else
    return 1
  fi
  reset_at=$at
  ((NOW >= at))
}

# The note of the reset after which a session was last sent its instruction. It holds the
# moment and not the words of the line: the same hour on another day is another reset.
resent_mark() {
  echo "$main/.claude/worktrees/ticket-${1#*-}/$SHIPLINE_STATE_FOLDER/$1.resent"
}

failed=0
woken=()
wake_done=0
local_done=0
budget_ready() {
  python3 "$here/github_budget.py" ready tick
}
# GitHub pauses do not hold back what needs no GitHub: squeezing and resending after a
# usage reset, then local alerts and pending owner/cloud notifications in the wake.
paused() {
  ((local_done)) || local_duties
  if ((wake_done == 0)); then
    wake_done=1
    bash "$here/wake" "${woken[@]}" 9>&- || true
  fi
  exit 0
}
local_duties() {
  local_done=1
  running=$(session list) || failed=1

  while read -r name state held _; do
    if [[ $state =~ ^(idle|limit)$ && $held =~ ^[0-9]+$ ]] && ((held > SQUEEZE_ABOVE_MB)); then
      session squeeze "$name" || failed=1
    fi
  done <<<"$running"

  # A session the usage limit stopped is neither working nor waiting for the owner, and nothing
  # else wakes it. A hunt is left: its time ran on while it was stopped. The reset is written
  # down after the instruction is sent, so a failed send is retried on the next tick.
  while read -r name state rest; do
    [[ $state == limit && $name =~ ^(ticket|audit|review)- && $rest == *"  resets "* ]] || continue
    session_current "$name" || continue
    limit=${rest%%  resets *}
    mark=$(resent_mark "$name")
    reset_at=""
    if ! reset_has_passed "${limit##*  }" "${rest##*  resets }"; then
      [[ $reset_at =~ ^[0-9]+$ ]] && [[ ! -r $mark || $(<"$mark") != "$reset_at" ]] &&
        shadow_due $((reset_at - NOW)) "$name was sent its instruction again"
      continue
    fi
    [[ ! -r $mark || $(<"$mark") != "$reset_at" ]] || continue
    ((shadow)) || mkdir -p "${mark%/*}" || { failed=1; continue; }
    if session resend "$name"; then
      write_session_note "$name" "$mark" "$reset_at" || { failed=1; continue; }
      woken+=("$name")
    else
      failed=1
    fi
  done <<<"$running"
}

# Set in the timer environment, or persistently in this file. Claude stays the default until
# the owner has compared the three Codex trial tickets.
program=${WORKFLOW_WORKER_PROGRAM:-}
if [[ -z $program && -r $main/$SHIPLINE_STATE_FOLDER/worker-program ]]; then
  read -r program <"$main/$SHIPLINE_STATE_FOLDER/worker-program"
fi
program=${program:-claude}
[[ $program =~ ^(claude|codex|cloud)$ ]] || { echo "invalid worker program: $program" >&2; exit 1; }
listed=-
running=$(session list) || { failed=1; listed=unread; }
# From the sessions just listed: the sample asks GitHub nothing and lists nothing again.
((shadow)) ||
  bash "$here/workflow-metrics" --sample --sessions "$listed" <<<"$running" 9>&- || failed=1

# Before GitHub is asked anything: a hunt or an analyst has no pull request, and its time runs
# out whether or not GitHub answers. An analyst's closing line is read whatever its state: it
# asks nobody anything, and its stop hook marks nothing. `session cleanup` notes its report.
while read -r name _; do
  if [[ $name == hunt-* ]] && is_over_its_time "$name" "$HUNT_STOPPED_AFTER_MINUTES"; then
    say "$name is over its time"
    session stop "$name" || failed=1
  elif [[ $name == hunt-* ]]; then
    shadow_over_due "$name" "$HUNT_STOPPED_AFTER_MINUTES"
  elif [[ $name == analyst-* ]]; then
    if is_over_its_time "$name" "$ANALYST_STOPPED_AFTER_MINUTES"; then
      say "$name is over its time"
    else
      if ! said_finished "$name"; then
        shadow_over_due "$name" "$ANALYST_STOPPED_AFTER_MINUTES"
        continue
      fi
    fi
    session stop "$name" || failed=1
  fi
done <<<"$running"

# Local hunt deadlines still apply while GitHub is unavailable.
if ! budget_ready; then
  session cleanup hunts
  paused
fi

# Poll every cloud record, including unlabelled tickets, before the ordinary ready path.
((shadow)) || python3 -B "$here/cloud_workers.py" poll "$main" 9>&- || failed=1
budget_ready || paused

# The daily metrics read a week of runs from GitHub, minutes on a first run: they run detached,
# under a lock of their own, and the tick goes on. The run itself leaves when one is running
# and waits half an hour after one that failed. It is given the tick's time, so it names the
# day the tick looked for. One command alone goes to the background: a list would fork a shell
# that keeps the tick's lock, and its output, for as long as the run.
if ((shadow == 0)) && [[ $METRICS_DAILY_AT =~ ^([0-9]{2}):([0-9]{2})$ ]] &&
    ((10#$(date -u -d "@$NOW" +%H%M) >= 10#${BASH_REMATCH[1]}${BASH_REMATCH[2]})) &&
    [[ ! -e $main/.local/analyses/metrics-$(date -u -d "@$NOW" +%F).md ]]; then
  if mkdir -p "$HOME/.local/state/workflow"; then
    env -u WORKFLOW_TRAIN_TICK -u WORKFLOW_SESSION_SNAPSHOT -u WORKFLOW_DEFER_START \
      WORKFLOW_NOW="$NOW" setsid bash "$here/workflow-metrics" --daily </dev/null \
      >>"$HOME/.local/state/workflow/metrics.log" 2>&1 7>&- 9>&- &
  else
    failed=1
  fi
fi

snapshot=$WORKFLOW_TRAIN_TICK/pulls.json
# The labelled pull requests, as "<number> <draft> <base>". Starts go in the order the merge
# train serves: by priority, then the older ticket.
labelled_pulls() {
  jq -r -L "$here" 'include "priority";
    [.[] | select(any(.labels[]; .name == workflow_label))] | sort_by(priority_rank, .number) |
    .[] | "\(.number) \(.isDraft) \(.baseRefName)"' "$snapshot"
}
if ! python3 "$here/tick_snapshot.py" create "$snapshot" 9>&- || ! pulls=$(labelled_pulls); then
  echo "cannot list the pull requests; the next tick tries again" >&2
  # The application an ended hunt left running is stopped all the same.
  session cleanup hunts
  budget_ready || paused
  exit 1
fi

while read -r name state _; do
  # Codex's latest turn is authoritative even if its bridge never ran the Stop hook.
  if [[ $name == ticket-* && -e $main/.claude/worktrees/$name/$SHIPLINE_STATE_FOLDER/$name.codex ]]; then
    if ! grep -qE "^${name#ticket-} true " <<<"$pulls" && said_finished "$name"; then
      session stop "$name" || failed=1
      continue
    fi
    if bridge_parse_failed "$name"; then
      session bridge "$name" || failed=1
      continue
    fi
  fi
  [[ $state == idle ]] || continue
  # An analyst is stopped above, whatever its state.
  [[ $name != analyst-* ]] || continue
  # A Codex worker whose bridge ended is listed idle, and nobody would read its end or relay
  # its question. Its bridge is started again; it shows Codex's last turn.
  if [[ $name == ticket-* && -e $main/.claude/worktrees/$name/$SHIPLINE_STATE_FOLDER/$name.codex ]] &&
      ! tmux -L "$name" has-session -t "=$name" 2>/dev/null 9>&- &&
      { grep -qE "^${name#ticket-} true " <<<"$pulls" || ! said_finished "$name"; }; then
    session bridge "$name" || failed=1
    continue
  fi
  # A draft without a session gets a worker below, so the worker of a draft is never stopped
  # here: the next tick would start it again.
  [[ $name != ticket-* ]] || ! grep -qE "^${name#ticket-} true " <<<"$pulls" || continue
  if [[ $name == review-* ]] && said_finished "$name" "review sent back"; then
    if grep -qE "^${name#review-} true " <<<"$pulls"; then
      session stop "$name" || failed=1
    fi
  elif said_finished "$name"; then
    if [[ $name == review-* ]] && grep -qE "^${name#review-} false " <<<"$pulls" &&
        ! grep -qxF "${name#review-} false main" <<<"$pulls"; then
      # A reviewed stack member waits for its base; do not start it every three minutes.
      head=$(git -C "$main/.claude/worktrees/ticket-${name#review-}" rev-parse HEAD 9>&-) ||
        { failed=1; continue; }
      write_session_note "$name" "$main/$SHIPLINE_STATE_FOLDER/$name.head" "$head" || { failed=1; continue; }
    fi
    if [[ $name == review-* ]] && grep -qxF "${name#review-} false main" <<<"$pulls"; then
      # Unread, the break would be lost with the session: it waits for the next tick.
      note_rule_break "${name#review-}" || { failed=1; continue; }
    fi
    session stop "$name" || failed=1
  fi
done <<<"$running"

WORKFLOW_PR_SNAPSHOT=$snapshot session cleanup || failed=1

local_duties

# Refresh main before computing wake tokens: PR checks can finish while main is pending.
# The tick alone requests one failed-job retry, after verifying home-runner evidence. A shadow
# tick reads the report as the real tick left it.
if ((shadow == 0)); then
  WORKFLOW_BACKGROUND_GITHUB=1 bash "$here/main-status" --tick-main-status 9>&- || failed=1
  budget_ready || paused
fi

# Passed reviews can leave a durable merge handoff instead of a model waiting in line.
# The driver calls the same gate and returns every refusal needing judgment to review. A failing
# test of a handoff's own makes it a draft, which a worker below fixes in its line place; its
# runners' failure is re-run once (`check_repair.py`).
if ((shadow == 0)); then
  WORKFLOW_BACKGROUND_GITHUB=1 python3 -B "$here/merge_driver.py" 9>&- || failed=1
  budget_ready || paused
fi
running=$(session list) || failed=1

# A stopped watch needs no shell restarted. A check-wait note is enough, even before the
# reviewer publishes its round. An idle reviewer without that note still needs its own round
# after its session started, on the head or an ancestor. Unknown or empty checks are not
# finished; failures are finished too.
# The sessions given a message in this tick: step 8 gives them no second one.
nudged=" "
if train=$(WORKFLOW_BACKGROUND_GITHUB=1 bash "$here/merge-when-current" --train-status 9>&-); then
# A shadow tick notes the line it read whenever it changed: it explains a decision that differs.
if ((shadow)); then
  last=$(tac "$SHIPLINE_SHADOW" | grep -m 1 -E '^[0-9]+ train status: ' | cut -d ' ' -f 2-)
  [[ $last == "train status: $train" ]] || shadow_note "train status: $train"
fi
while read -r name state _; do
  [[ $state != limit && $name =~ ^(review|audit)-([0-9]+)$ ]] || continue
  number=${BASH_REMATCH[2]}
  session_current "$name" || continue
  # Another member's gate call merged this one in a batch: it is no longer open or in the
  # train, and its own session still owes the after-merge duties.
  batch_merged=$main/$SHIPLINE_STATE_FOLDER/batch-merged-$number
  worktree=$main/.claude/worktrees/ticket-$number
  notes=$worktree/$SHIPLINE_STATE_FOLDER/$name
  in_line=false
  if jq -e --arg number "$number" '(.waiting + .blocked) | index($number) != null' \
      <<<"$train" >/dev/null; then
    in_line=true
  fi
  # An audit waiting for its checks before it joined the line is woken for a lost check only.
  only_lost=false
  if [[ -e $batch_merged ]]; then
    :
  elif [[ $name == review-* ]]; then
    grep -qE "^$number false " <<<"$pulls" || continue
  elif [[ $in_line == false ]]; then
    # Audits do not carry the workflow label. Only a known train entry may wake one, but for a
    # lost check while it waits.
    [[ -e $notes.checks-wait ]] || continue
    only_lost=true
  fi
  # `.pushed` also protects questions left by hooks from before owner-blocked existed.
  [[ $name == audit-* || -e $notes.started ]] || continue
  [[ -e $notes.checks-wait || ($name == review-* && $state == idle) ]] || continue
  [[ ! -e $notes.owner-blocked && ! -e $notes.interaction-blocked && ! -e $notes.pushed ]] || continue
  said_finished "$name" && continue
  said_finished "$name" "review sent back" && continue
  asks_owner "$name" && continue
  if [[ -e $batch_merged ]]; then
    mark=$main/$SHIPLINE_STATE_FOLDER/$name.batch-merged-nudged
    [[ ! -e $mark ]] || continue
    # The squash commit, or the merged head when the gate could not read main after it.
    squash=$(jq -er '(.squash // .head) | select(type == "string" and test("^[0-9a-f]{40}$"))' \
      "$batch_merged") || { failed=1; continue; }
    if delivery=$(session batch-merged "$name" "$squash" 2>&1); then
      nudged+="$name "
      write_session_note "$name" "$mark" "$squash" || { failed=1; continue; }
      wake_log "$name merged in a batch as $squash; session nudged" || failed=1
    else
      echo "$delivery" >&2
      failed=1
    fi
    continue
  fi
  if ! pull=$(python3 "$here/tick_snapshot.py" view "$snapshot" "$number" 9>&-); then
    failed=1
    continue
  fi
  if ! head=$(jq -er 'select(.state == "OPEN" and .isDraft == false) | .headRefOid |
    select(type == "string" and test("^[0-9a-f]{40}$"))' <<<"$pull"); then
    continue
  fi
  # A conflict can prevent CI from starting. Wake once per head, before the checks
  # and train-turn gates, using the same owner/input protections as a checks wake.
  if [[ $only_lost == false ]] && jq -e '.baseRefName == "main" and
    (.mergeable == "CONFLICTING" or .mergeStateStatus == "DIRTY")' <<<"$pull" >/dev/null; then
    mark=$main/$SHIPLINE_STATE_FOLDER/$name.conflict-nudged-$head
    [[ ! -e $mark ]] || continue
    if delivery=$(session conflict-found "$name" "$head" 2>&1); then
      nudged+="$name "
      write_session_note "$name" "$mark" "$head" || { failed=1; continue; }
      wake_log "$name merge conflict on $head; reviewer nudged" || failed=1
    else
      echo "$delivery" >&2
      failed=1
    fi
    continue
  fi
  mark=$main/$SHIPLINE_STATE_FOLDER/$name.checks-nudged-$head
  if jq -e --arg number "$number" '.waiting | index($number) != null' <<<"$train" >/dev/null; then
    [[ $(jq -r '.first' <<<"$train") == "$number" ]] || continue
    # A turn can arrive after this head's checks already woke the reviewer. Persist a
    # separate token so restarting the tick neither loses the turn nor repeats it.
    turn=$(jq -r '.turn' <<<"$train")
    health=$(sha256sum "$main/$SHIPLINE_STATE_FOLDER/main-status") || { failed=1; continue; }
    mark=$main/$SHIPLINE_STATE_FOLDER/$name.train-nudged-$turn-${health%% *}-$head
  fi
  # A check GitHub lost after its run finished never completes: the gate runs CI again for it.
  # In the line, the wake still comes again for a new turn or state of main. A failed member's
  # lost check is not run again: it is woken once per head as if its checks had finished.
  lost=false
  if jq -e --arg number "$number" --arg head "$head" '.lost[$number].head == $head' \
    <<<"$train" >/dev/null; then
    lost=true
    if jq -e --arg number "$number" '.lost[$number].failed == true' <<<"$train" >/dev/null; then
      lost=failed
    elif [[ $mark == */$name.train-nudged-* ]]; then
      mark=$mark-lost
    else
      mark=$main/$SHIPLINE_STATE_FOLDER/$name.lost-nudged-$head
    fi
  fi
  [[ ! -e $mark ]] || continue
  # CI result is always scheduled, so a partial rollup before it exists is not done.
  # Only skipped image planners means the draft run; ready must get its new run first.
  # GitHub keeps skipped draft checks beside the ready run on the same head.
  if [[ $lost == false ]] && { [[ $only_lost == true ]] || ! jq -e --arg result "$SHIPLINE_CI_RESULT" \
    --arg images "$SHIPLINE_IMAGES_PLAN" --arg images_prefix "$SHIPLINE_IMAGES" \
    --argjson prefix_only "$(jq -c '.checks.prefix_only // []' <<<"$SHIPLINE_CONFIG")" '
    .statusCheckRollup | if type == "array" then
      map(select(((($prefix_only | index("images")) != null) and
        ((.name // "") == $images_prefix or ((.name // "") | startswith($images_prefix + ":")))) | not))
    else . end | type == "array" and
    any(.[]; .name == $result) and
    (all(.[]; .name != $images) or
      any(.[]; .name == $images and .conclusion != "SKIPPED")) and all(.[];
    if .__typename == "CheckRun" then .status == "COMPLETED"
    elif .__typename == "StatusContext" then (.state | IN("SUCCESS", "FAILURE", "ERROR"))
    else false end)' <<<"$pull" >/dev/null; }; then
    # Before the line, a lost check is seen by no gate: the tick looks for one itself, as the
    # gate would, and tells the session once per head. Each run is read once in this tick. One
    # lost beside a failure is woken, once per head, as if its checks had finished.
    [[ $in_line == false && -e $notes.checks-wait ]] || continue
    [[ ! -e $main/$SHIPLINE_STATE_FOLDER/$name.lost-nudged-$head ]] || continue
    WORKFLOW_BACKGROUND_GITHUB=1 python3 -B "$here/tick_lost_check.py" \
      "$main/$SHIPLINE_STATE_FOLDER" "$number" <<<"$pull" 9>&-
    found=$?
    ((found != 3)) || continue
    if ((found == 4)); then
      lost=failed
      mark=$main/$SHIPLINE_STATE_FOLDER/$name.checks-nudged-$head
    else
      ((found == 0)) || { failed=1; continue; }
      lost=true
      mark=$main/$SHIPLINE_STATE_FOLDER/$name.lost-nudged-$head
    fi
  fi
  if [[ ! -e $notes.checks-wait ]]; then
    started=$(stat -c %Y "$notes.started" 9>&-) || continue
    if ! reviews=$(gh api --paginate "repos/$SHIPLINE_REPOSITORY/pulls/$number/reviews" 9>&-); then
      failed=1
      continue
    fi
    rounds=$(jq -sr --argjson started "$started" '.[][] |
      select(((.body // "") | strings | startswith("<!-- workflow-review round=")) and
        ((.submitted_at // "") | strings | (try fromdateiso8601 catch 0)) >= $started and
        ((.commit_id // "") | strings | test("^[0-9a-f]{40}$"))) | .commit_id' <<<"$reviews") ||
      continue
    [[ -n $rounds ]] || continue
    # A head pushed from elsewhere is fetched once; a branch rewritten past the round has no
    # path back to it and is not woken.
    git -C "$worktree" cat-file -e "$head^{commit}" 2>/dev/null 9>&- ||
      git -C "$worktree" fetch --quiet origin 9>&- || { failed=1; continue; }
    own=false
    while read -r round; do
      if git -C "$worktree" merge-base --is-ancestor "$round" "$head" 2>/dev/null 9>&-; then
        own=true
        break
      fi
    done <<<"$rounds"
    [[ $own == true ]] || continue
  fi
  wake=checks-finished
  [[ $lost != true ]] || wake=lost-check
  if delivery=$(session "$wake" "$name" "$head" 2>&1); then
    nudged+="$name "
    write_session_note "$name" "$mark" "$head" || { failed=1; continue; }
    wake_log "$name ${wake//-/ } on $head; reviewer nudged" || failed=1
  else
    echo "$delivery" >&2
    wake_log "$name wake failed: $delivery"
    failed=1
  fi
done <<<"$running"
else
  echo "cannot read the merge train; reviewer nudges wait for the next tick" >&2
  failed=1
fi

# Step 8.
# When a note was last written, in seconds.
written_at() {
  stat -c %Y "$1" 2>/dev/null 9>&-
}

# A sum of what the screen shows above the box. Left out is what changes while nothing happens:
# the box and the status line under it, the spinner's line (its mark, word and clock), and any
# elapsed time printed elsewhere ("Running… (3m 2s)").
screen_sum() {
  local screen top sum
  screen=$(tmux -L "$1" capture-pane -p -t "=$1:" 2>/dev/null 9>&-) || return 1
  top=$(LC_ALL=C awk '/^─/ { above = last; last = NR }
    END { print above ? above : (last ? last : NR + 1) }' <<<"$screen")
  sum=$(LC_ALL=C sed -n "1,$((top - 1))p" <<<"$screen" |
    { LC_ALL=C grep -vE '^[[:space:]]*(·|✢|✳|✶|✻|✽|\*)[[:space:]]+[^[:space:]]+…' || true; } |
    LC_ALL=C sed -E 's/[0-9]+(\.[0-9]+)?(ms|s|m|h)\b//g' | cksum) || return 1
  echo "${sum%% *}"
}

# A line for the wake, kept until the orchestrator was told it. `key` names it once.
note_for_wake() {
  local key=$1 line=$2 folder=$main/$SHIPLINE_STATE_FOLDER/stuck.pending
  ((shadow == 0)) || folder=$SHIPLINE_SHADOW_NOTES/stuck.pending
  mkdir -p "$folder" && jq -n --arg line "$line" '{line: $line}' >"$folder/$key.json"
}

# A session that would be told something: not given a message already in this tick, not
# finished, asking the owner nothing on its screen, and nothing typed into its box but a message
# of the tick's own that did not go (its `.typed` note): the session command sends that one,
# only when the box still holds exactly it, and exits 3 when it holds anything else.
quiet() {
  [[ $nudged != *" $1 "* ]] && ! said_finished "$1" && ! said_finished "$1" "review sent back" &&
    ! asks_owner "$1" && {
      bash "$here/bridge-empty" "$1" 9>&- ||
        [[ -e $main/.claude/worktrees/ticket-${1#*-}/$SHIPLINE_STATE_FOLDER/$1.typed ]]
    }
}

# A permission dialog stays on the screen, unchanged, until the owner answers it. Its prompt
# already rang the phone: the session is waiting for him, not stuck.
asks_permission() {
  local screen
  screen=$(tmux -L "$1" capture-pane -p -t "=$1:" 2>/dev/null 9>&-) || return 1
  LC_ALL=C grep -qE '^[[:space:]│]*Do you want to [^?]*\?' <<<"$screen"
}

# The last line of words above the box, without the mark Claude draws before it. The lines
# Claude draws itself, its spinner and the time a turn took ("✻ Worked for 3m 2s"), are not
# words of the session.
last_line() {
  local screen top
  screen=$(tmux -L "$1" capture-pane -p -t "=$1:" 2>/dev/null 9>&-) || return 1
  top=$(LC_ALL=C awk '/^─/ { above = last; last = NR }
    END { print above ? above : (last ? last : NR + 1) }' <<<"$screen")
  LC_ALL=C sed -n "1,$((top - 1))p" <<<"$screen" |
    { LC_ALL=C grep -vE '^[[:space:]]*((·|✢|✳|✶|✻|✽)[[:space:]]|\*[[:space:]]+[^[:space:]]+…)' || true; } |
    LC_ALL=C sed -E 's/^[[:space:]]*((●|⎿)[[:space:]]*)*//; s/[[:space:]]+$//' |
    LC_ALL=C awk 'NF { line = $0 } END { print line }'
}

# Interrupts a busy session that does not move and tells it why (`session nudge-busy`). Sets
# outcome to what the wake line says of it: "; nudge sent", "; nudge failed", "; interrupted,
# text left in its box" when Escape put a queued message back, or nothing when the session was
# left alone. Escape is never pressed on a dialog, a question to the owner or text in the box.
# A nudge that failed leaves a `.nudge-retry` note: when the box still holds its message (its
# Enter was not taken after Escape), the next passes send it again (`retry_nudge`), never with
# a second Escape.
nudge_busy() {
  local name=$1 kind=$2 delivery sent
  outcome=""
  asks_permission "$name" && return 0
  quiet "$name" || return 0
  delivery=$(session nudge-busy "$name" "$kind" 2>&1)
  sent=$?
  if ((sent == 0)); then
    nudged+="$name "
    outcome="; nudge sent"
  elif ((sent == 4)); then
    nudged+="$name "
    outcome="; interrupted, text left in its box"
  elif ((sent != 3)); then
    nudged+="$name "
    echo "$delivery" >&2
    wake_log "$name $3 nudge failed: $delivery"
    outcome="; nudge failed"
    write_session_note "$name" "$main/$SHIPLINE_STATE_FOLDER/$name.nudge-retry" "$kind 0" || true
    failed=1
  fi
}

# Sends again a nudge whose Enter was not taken, while the box still holds exactly it, at most
# NUDGE_RETRIES times; then the wake is told once that it stays in the box. Anything else in
# the box, or a session that went on, ends the retry.
retry_nudge() {
  local name=$1 note=$main/$SHIPLINE_STATE_FOLDER/$1.nudge-retry kind tries delivery sent
  { read -r kind tries <"$note"; } 2>/dev/null || return 0
  if [[ ! $kind =~ ^(still|loop)$ || ! $tries =~ ^[0-9]+$ ]] || ! holds_own_nudge "$name"; then
    ((shadow)) || rm -f "$note"
    return 0
  fi
  if ((tries >= NUDGE_RETRIES)); then
    if note_for_wake "$name-retry-$NOW" "stuck? $name (nudge not taken; its text stays in the box)"; then
      ((shadow)) || rm -f "$note"
      wake_log "$name $kind nudge not taken after $tries more tries" || failed=1
    else
      failed=1
    fi
    return 0
  fi
  delivery=$(session nudge-busy "$name" "$kind" again 2>&1)
  sent=$?
  if ((sent == 0)); then
    nudged+="$name "
    ((shadow)) || rm -f "$note"
    wake_log "$name $kind nudge sent again after its Enter was not taken" || failed=1
  elif ((sent == 3)); then
    ((shadow)) || rm -f "$note"
  else
    nudged+="$name "
    write_session_note "$name" "$note" "$kind $((tries + 1))" || failed=1
    echo "$delivery" >&2
    wake_log "$name $kind nudge failed again: $delivery"
    failed=1
  fi
}

# Whether the session's box holds a message of the tick's own (its `.typed` note).
holds_own_nudge() {
  [[ -e $main/.claude/worktrees/ticket-${1#*-}/$SHIPLINE_STATE_FOLDER/$1.typed ]] &&
    ! bash "$here/bridge-empty" "$1" 9>&-
}

running=$(session list) || failed=1

# Where the tick notes when a session's screen last changed. A shadow tick notes it in its own
# notes for the rest of its run, and reads the real tick's until it has.
screen_seen() {
  local real=$main/$SHIPLINE_STATE_FOLDER/$1.screen-seen own
  ((shadow)) || { echo "$real"; return; }
  own=$SHIPLINE_SHADOW_NOTES/screen-seen/$1
  if [[ -e $own || ${2:-} == write ]]; then echo "$own"; else echo "$real"; fi
}

# When each screen last changed, or the session's state: the 45-minute rule below counts from
# it, and `session list` shows it. A session's first look is a change.
while read -r name state _; do
  [[ $name =~ ^(ticket|review|audit)-[0-9]+$ || $name == hunt-* || $name == analyst-* ]] || continue
  session_current "$name" || continue
  # The state goes with the sum: a session that turns busy starts its 45 minutes then.
  sum=$(screen_sum "$name")/$state || continue
  seen=$(screen_seen "$name")
  { read -r last_sum last_since <"$seen"; } 2>/dev/null || last_sum=""
  if [[ $last_sum != "$sum" || ! $last_since =~ ^[0-9]+$ ]]; then
    seen=$(screen_seen "$name" write)
    if ((shadow)); then
      mkdir -p "${seen%/*}" && echo "$sum $NOW" >"$seen" || failed=1
    else
      write_session_note "$name" "$seen" "$sum $NOW" || failed=1
    fi
  fi
done <<<"$running"

while read -r name state _; do
  [[ $state != limit && $name =~ ^(ticket|review)-([0-9]+)$ ]] || continue
  number=${BASH_REMATCH[2]}
  session_current "$name" || continue
  notes=$main/.claude/worktrees/ticket-$number/$SHIPLINE_STATE_FOLDER/$name
  [[ ! -e $notes.codex ]] || continue
  [[ ! -e $notes.owner-blocked && ! -e $notes.interaction-blocked ]] || continue

  # Waiting for its own job, or a reviewer for its turn in the merge train. The stretch begins
  # at the stop that started the wait, and a message the session answers begins another.
  since=""
  if [[ -e $notes.job-wait ]]; then
    since=$(written_at "$notes.job-wait")
  elif [[ -e $notes.checks-wait ]]; then
    since=$(written_at "$notes.checks-wait")
  elif [[ $name == review-* && -e $notes.idle && -n ${train:-} ]] &&
      jq -e --arg number "$number" '.waiting | index($number) != null' <<<"$train" >/dev/null 2>&1; then
    since=$(written_at "$notes.idle")
  fi
  mark=$main/$SHIPLINE_STATE_FOLDER/$name.kept-alive
  if [[ $since =~ ^[0-9]+$ && ! -e $notes.asking ]] && ((NOW - since >= KEEP_ALIVE_AFTER_SECONDS)) &&
      [[ ! -r $mark || $(<"$mark") != "$since" ]] && quiet "$name"; then
    delivery=$(session status-check "$name" 2>&1)
    sent=$?
    if ((sent == 0)); then
      write_session_note "$name" "$mark" "$since" || failed=1
      wake_log "$name idle $(((NOW - since) / 60)) min waiting for its own job or turn; status check sent" ||
        failed=1
    elif ((sent != 3)); then
      echo "$delivery" >&2
      wake_log "$name status check failed: $delivery"
      failed=1
    fi
  elif ((shadow)) && [[ $since =~ ^[0-9]+$ && ! -e $notes.asking ]] &&
      ((NOW - since < KEEP_ALIVE_AFTER_SECONDS)) &&
      [[ ! -r $mark || $(<"$mark") != "$since" ]] && quiet "$name"; then
    shadow_due $((since + KEEP_ALIVE_AFTER_SECONDS - NOW)) "$name idle" \
      "$((KEEP_ALIVE_AFTER_SECONDS / 60)) min waiting for its own job or turn; status check sent"
  fi

  # A worker whose pull request is ready, idle without "worker finished": the tick stopped it
  # above if it had said so. Ready is counted from when the tick first saw it ready.
  ready=$main/$SHIPLINE_STATE_FOLDER/$name.ready-seen
  if [[ $name == ticket-* ]] && grep -qE "^$number false " <<<"$pulls"; then
    [[ -r $ready ]] || write_session_note "$name" "$ready" "$NOW" || failed=1
    # A shadow tick counts from now what the real tick notes now.
    ready_at=""
    ((shadow == 0)) || ready_at=$NOW
    [[ ! -r $ready ]] || read -r ready_at <"$ready"
    idle_at=""
    [[ ! -e $notes.idle ]] || idle_at=$(written_at "$notes.idle")
    mark=$main/$SHIPLINE_STATE_FOLDER/$name.ready-nudged
    if [[ $ready_at =~ ^[0-9]+$ && $idle_at =~ ^[0-9]+$ ]] &&
        ((NOW - (ready_at > idle_at ? ready_at : idle_at) >= READY_UNFINISHED_SECONDS)) &&
        [[ ! -r $mark || $(<"$mark") != "$ready_at" ]] && quiet "$name"; then
      delivery=$(session finish-ready "$name" 2>&1)
      sent=$?
      if ((sent == 0)); then
        write_session_note "$name" "$mark" "$ready_at" || failed=1
        wake_log "$name idle on ready pull request $number without worker finished; told to finish" ||
          failed=1
      elif ((sent != 3)); then
        echo "$delivery" >&2
        wake_log "$name finish message failed: $delivery"
        failed=1
      fi
    elif ((shadow)) && [[ $ready_at =~ ^[0-9]+$ && $idle_at =~ ^[0-9]+$ ]] &&
        [[ ! -r $mark || $(<"$mark") != "$ready_at" ]] && quiet "$name"; then
      shadow_due $(((ready_at > idle_at ? ready_at : idle_at) + READY_UNFINISHED_SECONDS - NOW)) \
        "$name idle on ready pull request $number without worker finished; told to finish"
    fi
  elif [[ $name == ticket-* ]]; then
    ((shadow)) || rm -f "$ready"
  fi

  # Busy, and not a session that ended its turn to wait for its own job.
  busy=false
  [[ $state != busy || -e $notes.idle || -e $notes.job-wait || -e $notes.checks-wait ]] ||
    busy=true
  # The commit the session's work stands on: a new one is news even on a screen that is still.
  head=$(git -C "$main/.claude/worktrees/ticket-$number" rev-parse HEAD 2>/dev/null 9>&-) ||
    head=""
  # Since when its screen has not changed (the note the pass above keeps).
  last_since=""
  { read -r _ last_since <"$(screen_seen "$name")"; } 2>/dev/null || true
  [[ $last_since =~ ^[0-9]+$ ]] || last_since=$NOW
  [[ ! -e $main/$SHIPLINE_STATE_FOLDER/$name.nudge-retry ]] || retry_nudge "$name"

  # What it runs: a wait loop that finds its own shell never ends, whatever its screen shows.
  if activity=$(session running "$name" 2>/dev/null); then
    loop=$(jq -r '.finds_itself // ""' <<<"$activity")
    if [[ -n $loop ]]; then
      mark=$main/$SHIPLINE_STATE_FOLDER/$name.loop-noted
      if [[ ! -r $mark || $(<"$mark") != "$loop" ]]; then
        outcome=""
        later=false
        # Only when the loop is the command it started last and its screen stands still: Escape
        # would stop other work, not a loop left in the background. While the screen moves, the
        # loop is named when it stands still, the session ends its turn, or after 15 minutes. One
        # the tick may not type into is named at once.
        first=$main/$SHIPLINE_STATE_FOLDER/$name.loop-seen
        { read -r first_at first_loop <"$first"; } 2>/dev/null || first_loop=""
        if [[ $first_loop != "$loop" || ! $first_at =~ ^[0-9]+$ ]]; then
          first_at=$NOW
          write_session_note "$name" "$first" "$NOW $loop" || failed=1
        fi
        if [[ $busy == true && $(jq -r '.running // ""' <<<"$activity") == "$loop" &&
              $nudged != *" $name "* ]] && ! asks_permission "$name" && quiet "$name"; then
          if ((NOW - last_since >= LOOP_STILL_SECONDS)); then
            nudge_busy "$name" loop loop
          elif ((NOW - first_at < LOOP_NAMED_AFTER_SECONDS)); then
            later=true
            # Nudged once its screen has stood still 5 minutes, or named after 15, whichever
            # comes first.
            if ((last_since + LOOP_STILL_SECONDS <= first_at + LOOP_NAMED_AFTER_SECONDS)); then
              shadow_would_nudge "$name" loop && outcome="; nudge sent"
              shadow_due $((last_since + LOOP_STILL_SECONDS - NOW)) \
                "wait loop finds itself? $name (running: $loop)$outcome"
              outcome=""
            else
              shadow_due $((first_at + LOOP_NAMED_AFTER_SECONDS - NOW)) \
                "wait loop finds itself? $name (running: $loop)"
            fi
          fi
        fi
        line="wait loop finds itself? $name (running: $loop)$outcome"
        if [[ $later == true ]]; then
          :
        elif note_for_wake "$name-loop-$NOW" "$line"; then
          write_session_note "$name" "$mark" "$loop" || failed=1
          wake_log "$line" || failed=1
        else
          failed=1
        fi
      fi
    fi
  else
    activity='{"running": ""}'
  fi

  # Idle, and no rule above covers it: not a wait for its own job or turn, not a worker on a
  # ready pull request, not a question to the owner. Named once per head; nothing is typed.
  idle_at=""
  [[ ! -e $notes.idle ]] || idle_at=$(written_at "$notes.idle")
  mark=$main/$SHIPLINE_STATE_FOLDER/$name.idle-noted
  if ((shadow)) && [[ $state == idle && $idle_at =~ ^[0-9]+$ && -z $since && ! -e $notes.asking ]] &&
      ((NOW - idle_at < IDLE_NO_RULE_SECONDS)) &&
      { [[ $name != ticket-* ]] || ! grep -qE "^$number false " <<<"$pulls"; }; then
    [[ -r $mark && $(<"$mark") == "$head" ]] || ! quiet "$name" ||
      shadow_due $((idle_at + IDLE_NO_RULE_SECONDS - NOW)) \
        "idle, no rule: $name ($((IDLE_NO_RULE_SECONDS / 60)) min, last line: $(last_line "$name"))"
  fi
  if [[ $state == idle && $idle_at =~ ^[0-9]+$ && -z $since && ! -e $notes.asking ]] &&
      ((NOW - idle_at >= IDLE_NO_RULE_SECONDS)) &&
      { [[ $name != ticket-* ]] || ! grep -qE "^$number false " <<<"$pulls"; }; then
    if [[ ! -r $mark || $(<"$mark") != "$head" ]] && quiet "$name"; then
      line="idle, no rule: $name ($(((NOW - idle_at) / 60)) min, last line: $(last_line "$name"))"
      if note_for_wake "$name-idle-$NOW" "$line"; then
        write_session_note "$name" "$mark" "$head" || failed=1
        wake_log "$line" || failed=1
      else
        failed=1
      fi
    fi
  fi

  # A session given a message in this tick has a new screen at the next.
  [[ $busy == true && $nudged != *" $name "* ]] || continue
  mark=$main/$SHIPLINE_STATE_FOLDER/$name.stuck-noted
  what=$(jq -r '.running // ""' <<<"$activity")
  if ((NOW - last_since < STUCK_AFTER_SECONDS)); then
    # As `nudge_busy` will find it: a session that can be typed into is nudged.
    if ((shadow)) && [[ ! -r $mark || $(<"$mark") != "$last_since $head" ]] &&
        ! asks_permission "$name"; then
      outcome=""
      quiet "$name" && shadow_would_nudge "$name" still && outcome="; nudge sent"
      shadow_due $((last_since + STUCK_AFTER_SECONDS - NOW)) \
        "stuck? $name ($((STUCK_AFTER_SECONDS / 60)) min, running: ${what:-no command})$outcome"
    fi
    continue
  fi
  asks_permission "$name" && continue
  [[ ! -r $mark || $(<"$mark") != "$last_since $head" ]] || continue
  nudge_busy "$name" still stuck
  line="stuck? $name ($(((NOW - last_since) / 60)) min, running: ${what:-no command})$outcome"
  if note_for_wake "$name-stuck-$last_since-$NOW" "$line"; then
    write_session_note "$name" "$mark" "$last_since $head" || failed=1
    wake_log "$line" || failed=1
  else
    failed=1
  fi
done <<<"$running"

# A cloud worker whose draft had no push and no report for `cloud_wake_after_minutes`, with no
# open question, is woken once per quiet stretch, and one whose question was answered at once.
# A shadow tick wakes none: the wake is sent and noted by `cloud_workers.py` itself.
((shadow)) || python3 -B "$here/cloud_workers.py" wake "$main" "$snapshot" 9>&- || failed=1

# A question to the owner marked `Owner only: no` gets its recommended reply once it has waited,
# from the notes the stop hook wrote (`notify`): the time it was asked and the reply. Once for
# the same words: asked again after the answer, the question waits for the owner. His own reply
# drops the notes first; text in the box, a permission prompt or the usage limit stop it, as for
# every other message of the tick. A question kept for him waits; one without the line, or marked
# `no` without a reply word, waits too and is named in the wake once. Codex bridges relay and
# never answer. 0 minutes in the config turns it all off.
answer_after=$((10#${SHIPLINE_ANSWER_FOR_OWNER_AFTER_MINUTES:-15} * 60))
if ((answer_after > 0)); then
  running=$(session list) || failed=1
  while read -r name state _; do
    [[ $state == idle && $name =~ ^(ticket|review|audit)-([0-9]+)$ ]] || continue
    notes=$main/.claude/worktrees/ticket-${BASH_REMATCH[2]}/$SHIPLINE_STATE_FOLDER/$name
    session_current "$name" || continue
    [[ ! -e $notes.codex && -e $notes.idle && -r $notes.asking && -r $notes.question ]] || continue
    IFS= read -r asked <"$notes.asking" && [[ $asked =~ ^([0-9]+)\ [0-9]+$ ]] || continue
    asked_at=${BASH_REMATCH[1]}
    # The note of an earlier question is not this one's.
    question=$(jq -c --arg asked "$asked" 'select(.asked == $asked)' "$notes.question" 2>/dev/null) &&
      [[ -n $question ]] || continue
    owner_only=$(jq -r '.owner_only' <<<"$question")
    reply=$(jq -r '.reply // "" | strings' <<<"$question")
    if [[ $owner_only == missing || ( $owner_only == no && -z $reply ) ]]; then
      mark=$main/$SHIPLINE_STATE_FOLDER/$name.owner-question-noted
      [[ ! -r $mark || $(<"$mark") != "$asked" ]] || continue
      what="without a reply word"
      [[ $owner_only != missing ]] || what="without the Owner only line"
      if note_for_wake "$name-owner-question-$asked_at" "owner question $what: $name"; then
        write_session_note "$name" "$mark" "$asked" || failed=1
        wake_log "$name asks the owner $what; it waits for him" || failed=1
      else
        failed=1
      fi
      continue
    fi
    [[ $owner_only == no ]] || continue
    mark=$main/$SHIPLINE_STATE_FOLDER/$name.answered-for-owner
    if ((NOW - asked_at < answer_after)); then
      # A shadow tick notes the answer that comes due, as the checks below and the session's
      # own would find it.
      if ((shadow)) && [[ ! -r $mark || $(<"$mark") != "${asked#* }" ]] &&
          [[ $nudged != *" $name "* && ! -e $notes.interaction-blocked ]] &&
          ! asks_permission "$name" &&
          bash "$here/session" would-answer "$name" "$asked" >/dev/null 2>&1 9>&-; then
        shadow_due $((asked_at + answer_after - NOW)) "answered for the owner: $name, \"$reply\""
      fi
      continue
    fi
    [[ ! -r $mark || $(<"$mark") != "${asked#* }" ]] || continue
    [[ $nudged != *" $name "* && ! -e $notes.interaction-blocked ]] || continue
    ! asks_permission "$name" || continue
    delivery=$(session answer-for-owner "$name" "$asked" 2>&1)
    sent=$?
    if ((sent == 0)); then
      write_session_note "$name" "$mark" "${asked#* }" || failed=1
      wake_log "answered for the owner: $name, \"$reply\"" || failed=1
      # For the wake's check-in, which lists them so the owner can overrule them; a shadow
      # tick's for its own wake.
      answered=$main/$SHIPLINE_STATE_FOLDER/answered-for-owner.pending
      ((shadow == 0)) || answered=$SHIPLINE_SHADOW_NOTES/answered-for-owner.pending
      mkdir -p "$answered" &&
        jq -n --arg name "$name" --arg reply "$reply" --argjson at "$NOW" \
          '{name: $name, reply: $reply, at: $at}' >"$answered/.$NOW-$name.tmp" &&
        mv -- "$answered/.$NOW-$name.tmp" "$answered/$NOW-$name.json" || failed=1
    elif ((sent != 3)); then
      echo "$delivery" >&2
      wake_log "$name answer for the owner failed: $delivery"
      failed=1
    fi
  done <<<"$running"
fi

# Record reviewer-start notices before waking the orchestrator. Their reviewers start below.
((shadow)) || python3 -B "$here/merge_driver.py" --hand-backs 9>&- || failed=1
running=$(session list) || failed=1

# The program the orchestrator recorded for ticket N in `worker-program-N`, in `recorded`, or
# nothing. A record that names no program is read as none, and named in the wake once for
# what it holds.
recorded_program() {
  local record=$main/$SHIPLINE_STATE_FOLDER/worker-program-$1 text sum line
  recorded=""
  if [[ ! -e $record ]]; then
    ((shadow)) || rm -f "$record.noted"
    return 0
  fi
  if { text=$(<"$record"); } 2>/dev/null &&
      [[ $text =~ ^[[:space:]]*(cloud|claude|codex)[[:space:]]*$ ]]; then
    recorded=${BASH_REMATCH[1]}
    ((shadow)) || rm -f "$record.noted"
    return 0
  fi
  sum=$(cksum <"$record" 2>/dev/null) && sum=${sum%% *} || sum=unreadable
  [[ ! -r $record.noted || $(<"$record.noted") != "$sum" ]] || return 0
  line="worker-program-$1 names no worker program (cloud, claude or codex); read as no record"
  if note_for_wake "worker-program-$1-$sum" "$line"; then
    keep "$record.noted" "$sum" || failed=1
    wake_log "$line" || failed=1
  else
    failed=1
  fi
}

# Whether a draft goes to the cloud, if its screen check allows: always by a reservation of
# its own; else by the program recorded for it; else by the cloud default (a Codex fix round
# stays on Codex) or a cloud-built marker of its own. The starts held for memory and the
# worker start both ask this, so they never disagree.
cloud_candidate() {
  local notes=$main/$SHIPLINE_STATE_FOLDER
  [[ ! -e $notes/cloud-$1 ]] || return 0
  recorded_program "$1"
  if [[ -n $recorded ]]; then
    [[ $recorded == cloud ]]
    return
  fi
  [[ ( $program == cloud && ! -e $notes/codex-built-$1 ) || -e $notes/cloud-built-$1 ]]
}

# Whether a draft not started in the cloud goes to Codex, if its screen check allows: never
# with a reservation; else by the program recorded for it; else by the Codex default
# or a Codex-built marker of its own.
codex_candidate() {
  local notes=$main/$SHIPLINE_STATE_FOLDER
  [[ ! -e $notes/cloud-$1 ]] || return 1
  recorded_program "$1"
  if [[ -n $recorded ]]; then
    [[ $recorded == codex ]]
    return
  fi
  [[ $program == codex || -e $notes/codex-built-$1 ]]
}

# The starts, the program each worker gets and its launch, and the next ticket's label, go under
# the lock of `decide`: an orchestrator's decision and the tick's start never cross. Every
# session the tick starts closes it, as it closes the tick's own.
# Whether the starts and the pick go in this tick: the lock is held and what they read is fresh.
# A shadow tick takes no lock the installation's own decisions or tick may wait for: it reads
# the decisions as the real tick reads them under the lock.
starts_go=0
((shadow)) || exec 8>"$common/shipline-decide.lock"
if ((shadow)) || flock --timeout 60 8; then
  starts_go=1
  # A decision made since the snapshot may have labelled a ticket or chosen its program.
  records=$main/$SHIPLINE_STATE_FOLDER/decisions.jsonl
  if [[ -e $records && $records -nt $snapshot ]]; then
    if ! python3 "$here/tick_snapshot.py" create "$snapshot" 9>&- 8>&- || ! pulls=$(labelled_pulls); then
      echo "cannot list the pull requests again after a decision; starts wait for the next tick" >&2
      pulls=""
      starts_go=0
      failed=1
    fi
  fi
  # A ticket whose decision is not finished waits for the next call of `decide` to finish it.
  if ! unfinished=$(python3 -B "$here/decisions.py" unfinished 9>&- 8>&-); then
    echo "cannot read the decisions; starts wait for the next tick" >&2
    pulls=""
    starts_go=0
    failed=1
  fi
else
  echo "a decision holds the lock of decide; starts wait for the next tick"
  pulls=""
  unfinished=""
fi

# A start that waits for memory (75) holds later local starts. Cloud starts use no
# local worker memory, so they can still go ahead; nothing else is asked about.
started=0
local_starts_held=0
while read -r number draft base; do
  ((started != 75)) || local_starts_held=1
  [[ $number =~ ^[0-9]+$ ]] || continue
  ! grep -qxF "$number" <<<"$unfinished" || continue
  if ((local_starts_held)); then
    [[ $draft == true ]] && cloud_candidate "$number" || continue
  fi
  if [[ -e $main/$SHIPLINE_STATE_FOLDER/cloud-$number ]]; then
    [[ $draft == true ]] && python3 -B "$here/cloud_workers.py" retryable "$main" "$number" || continue
  fi
  if [[ -e $main/$SHIPLINE_STATE_FOLDER/merge-review-$number ]]; then
    ((local_starts_held == 0)) || continue
    # A hand-back's fresh reviewer, at its pull request's place in the order.
    if ((shadow)); then
      shadow_hand_back "$number"
    else
      python3 -B "$here/merge_driver.py" --start-hand-back "$number" 9>&-
    fi
    started=$?
    ((started == 0 || started == 75)) || failed=1
    continue
  fi
  [[ ! -e $main/$SHIPLINE_STATE_FOLDER/merge-wanted-$number &&
     ! -e $main/$SHIPLINE_STATE_FOLDER/merge-review-$number ]] || continue
  grep -qE "^(ticket|audit|review)-$number " <<<"$running" && continue
  # The start before this one may have taken minutes. Asked again, so that a pull request
  # marked ready in that time gets no worker: its own worker finished it.
  if ! now=$(list_pull_requests); then
    echo "cannot list the pull requests; the next tick tries again" >&2
    # The wake below still tells the orchestrator whom this tick resent.
    failed=1
    break
  fi
  grep -qxF "$number $draft $base" <<<"$now" || continue
  if [[ -e $main/$SHIPLINE_STATE_FOLDER/cloud-$number ]]; then
    [[ $draft == true ]] && python3 -B "$here/cloud_workers.py" retryable "$main" "$number" || continue
  fi
  if [[ $draft == true ]]; then
    # A reservation, a recorded program or a fix-round marker holds even after the default
    # changes. Both alternative programs share the conservative screen routing.
    if cloud_candidate "$number" && node "$here/codex-eligible.mjs" "$number" 9>&-; then
      python3 -B "$here/cloud_workers.py" allowed "$main" || continue
      session start worker "$number" medium cloud
    elif codex_candidate "$number" && node "$here/codex-eligible.mjs" "$number" 9>&-; then
      ((local_starts_held == 0)) || continue
      session start worker "$number" medium codex
    else
      [[ ! -e $main/$SHIPLINE_STATE_FOLDER/cloud-$number ]] || continue
      ((local_starts_held == 0)) || continue
      session start worker "$number"
    fi
    started=$?
    ((started == 0)) || failed=1
  elif [[ $draft == false ]]; then
    ((local_starts_held == 0)) || continue
    head=$(gh pr view "$number" --json state,headRefName,headRefOid \
      --jq '"\(.state) \(.headRefName) \(.headRefOid)"' 9>&-) || { failed=1; continue; }
    mark=$main/$SHIPLINE_STATE_FOLDER/review-$number.head
    if [[ $base == main ]]; then
      ((shadow)) || rm -f "$mark" || { failed=1; continue; }
    else
      [[ ! -r $mark || $(<"$mark") != "${head##* }" ]] || continue
    fi
    # Published independent rounds survive session restarts. Only the owner's allowance
    # for the exact next round may exceed the two-round limit.
    if ! reviews=$(gh api --paginate "repos/$SHIPLINE_REPOSITORY/pulls/$number/reviews" 9>&-); then
      echo "cannot read reviews for pull request $number; the next tick tries again" >&2
      failed=1
      continue
    fi
    if ! history=$(jq -scr '[.[][] | (.body // "") |
      capture("^<!-- workflow-review round=(?<round>[0-9]+)( result=(?<result>sent-back|passed))? -->")? |
      {round: (.round | tonumber), result: (.result // "sent-back")}] |
      [(map(.round) | max // 0), (map(select(.result == "sent-back")) | length)] | @tsv' <<<"$reviews"); then
      failed=1
      continue
    fi
    read -r round sent_back <<<"$history"
    branch=${head#* }
    if ((shadow)); then
      python3 -B "$here/reviewer_start.py" --shadow "$main/$SHIPLINE_STATE_FOLDER" "$number" \
        "${head##* }" "$((round + 1))" "$sent_back" "${branch% *}" 9>&- &&
        shadow_start review "$number"
    else
      python3 -B "$here/reviewer_start.py" "$main/$SHIPLINE_STATE_FOLDER" "$number" "${head##* }" "$((round + 1))" "$sent_back" "${branch% *}" 9>&-
    fi
    started=$?
    ((started == 0 || started == 2)) || failed=1
  fi
done <<<"$pulls"

if ((shadow == 0)); then
  python3 -B "$here/reviewer_start.py" --reconcile "$main/$SHIPLINE_STATE_FOLDER" 9>&- || failed=1

  # After this tick's own starts, which count as starts too: the next draft ticket gets the label
  # when one may start, and the next tick starts its worker.
  if ((starts_go)); then
    python3 -B "$here/ticket_starts.py" pick "$main" "$snapshot" 9>&- ||
      failed=1
  fi
fi
exec 8>&-

# Step 11, after the starts the tickets wait for, and not while one waits for memory.
if ((local_starts_held == 0 && started != 75)); then
  start_daily_analyst || failed=1
fi

# Step 12, after this tick's starts: the CI demand on its way, for the runner balancer. A shadow
# tick writes none: the forecast is what the machine's balancer acts on.
if ((shadow)); then
  :
elif running=$(session list); then
  # 75: the GitHub budget is paused; the forecast is written again at a later tick.
  python3 -B "$here/ci_demand.py" write "$main" "$snapshot" <<<"$running" 9>&- ||
    (($? == 75)) || failed=1
else
  failed=1
fi
# The last change of this machine's runner balancer, once, for the wake's next check-in. One
# older than a day (a first tick after an install, say) is no news. A shadow tick notes it for its
# own wake.
balance_log=$HOME/.local/state/workflow/runner-balance.log
balance_told=$main/$SHIPLINE_STATE_FOLDER/runner-balance.told
if [[ -s $balance_log ]] && balance_line=$(tail -n 1 "$balance_log") &&
    [[ -n $balance_line && $balance_line != "$(cat "$balance_told" 2>/dev/null)" ]] &&
    balance_at=$(date -u -d "${balance_line%% *}" +%s 2>/dev/null) &&
    ((NOW - balance_at < 86400)); then
  balance_pending=$main/$SHIPLINE_STATE_FOLDER/runner-balance.pending
  ((shadow == 0)) || balance_pending=$SHIPLINE_SHADOW_NOTES/runner-balance.pending
  if mkdir -p "$balance_pending" &&
      jq -n --arg line "$balance_line" '{line: $line}' >"$balance_pending/.balance.json" &&
      mv -- "$balance_pending/.balance.json" "$balance_pending/balance.json"; then
    keep "$balance_told" "$balance_line" || failed=1
  else
    failed=1
  fi
fi

wake_done=1
bash "$here/wake" "${woken[@]}" 9>&- || failed=1

budget_ready || paused
exit "$failed"
