#!/usr/bin/env bash
# A guard against workflow mistakes, not a security boundary around the real gh binary.
set -euo pipefail

# The repository and the priority labels, as the tick reads them (`workflow_config.py`).
# Without them, nothing names this worker's pull request or its labels, and its body update and
# its pull requests are refused. The caller's own values never stand in for them.
SHIPLINE_REPOSITORY="" SHIPLINE_PRIORITY_MEDIUM="" SHIPLINE_PRIORITY_HIGH=""
if config=$(python3 "$(dirname "${BASH_SOURCE[0]}")/../workflow_config.py" shell); then
  eval "$config"
fi

refuse() {
  if [[ ${WORKFLOW_SESSION:-} == review-* ]]; then
    echo "Codex conflict resolver: gh permits reads and its own conflict COMMENT round; this command is refused." >&2
  else
    echo "Codex worker: gh permits reads, its own ready/body update, and draft tickets labelled with only a medium or high priority; this command is refused." >&2
  fi
  exit 1
}

[[ ${WORKFLOW_SESSION:-} =~ ^(ticket|review)-[0-9]+$ && -n ${WORKFLOW_GH:-} ]] || refuse
conflict=false
if [[ $WORKFLOW_SESSION == review-* ]]; then
  conflict=true
  number=${WORKFLOW_SESSION#review-}
  folder=$SHIPLINE_REPO/$SHIPLINE_STATE_FOLDER
  [[ -e $SHIPLINE_REPO/.claude/worktrees/ticket-$number/$SHIPLINE_STATE_FOLDER/$WORKFLOW_SESSION.codex ]] || refuse
  # A resolver can only publish a COMMENT review on its own resolved head. No approval,
  # full round, ready, description edit, ticket creation or extra API argument is allowed.
  if [[ ${1:-} == api && $# == 6 && $2 == -X && $3 == POST &&
        $4 == "repos/$SHIPLINE_REPOSITORY/pulls/$number/reviews" && $5 == --input &&
        ! -e $folder/review-$number.usual-reviewer ]]; then
    extended=$(jq -er .head "$folder/review-$number.conflict.json") || refuse
    [[ $(python3 -B "$(dirname "${BASH_SOURCE[0]}")/../conflict_review.py" program "$folder" "$number") == codex* ]] || refuse
    jq -e --arg head "$(git rev-parse HEAD)" --arg extended "$extended" '
      keys == ["body", "commit_id", "event"] and .event == "COMMENT" and
      .commit_id == $head and (.body | type == "string") and
      (.body | test("^<!-- workflow-review round=[0-9]+ result=(passed|sent-back) -->\n")) and
      (.body | split("\n") | index("<!-- workflow-conflict extends=" + $extended + " -->") != null)
    ' "$6" >/dev/null || refuse
    exec env WORKFLOW_GITHUB_RAW_GH="$WORKFLOW_GH" python3 "$(dirname "${BASH_SOURCE[0]}")/../github_budget.py" foreground "$@"
  fi
fi
case ${1:-} in
  pr)
    case ${2:-} in
      view|list|diff|checks) ;;
      ready) [[ $conflict == false && $# == 3 && $3 == "${WORKFLOW_SESSION#ticket-}" ]] || refuse ;;
      create)
        [[ $conflict == false ]] || refuse
        draft=false
        args=("${@:3}")
        for ((i=0; i<${#args[@]}; i++)); do
          case ${args[i]} in
            --draft|-d) draft=true; continue ;;
            --label|-l)
              ((i+=1))
              [[ $i -lt ${#args[@]} ]] || refuse
              label=${args[i]}
              ;;
            --label=*) label=${args[i]#--label=} ;;
            -l*) label=${args[i]#-l} ;;
            *) continue ;;
          esac
          # Only the priority a session gives a ticket it opens; `workflow` would start it.
          [[ -n ${SHIPLINE_PRIORITY_MEDIUM:-} &&
             ( $label == "$SHIPLINE_PRIORITY_MEDIUM" || $label == "$SHIPLINE_PRIORITY_HIGH" ) ]] ||
            refuse
        done
        [[ $draft == true ]] || refuse
        ;;
      *) refuse ;;
    esac
    ;;
  issue) [[ ${2:-} == view || ${2:-} == list ]] || refuse ;;
  label) [[ ${2:-} == list ]] || refuse ;;
  api)
    # The one writable API shape: the body of this worker's own pull request.
    if [[ $conflict == false && -n $SHIPLINE_REPOSITORY && $# -ge 6 && $2 == -X && $3 == PATCH &&
          $4 == "repos/$SHIPLINE_REPOSITORY/pulls/${WORKFLOW_SESSION#ticket-}" &&
          $5 == -F && $6 == body=@?* ]]; then
      output_args=("${@:7}")
      for ((i=0; i<${#output_args[@]}; i++)); do
        case ${output_args[i]} in
          --jq|-q|--template|-t)
            ((i+=1))
            [[ $i -lt ${#output_args[@]} ]] || refuse
            ;;
          --silent|-i|--include|--verbose) ;;
          *) refuse ;;
        esac
      done
      exec env WORKFLOW_GITHUB_RAW_GH="$WORKFLOW_GH" python3 "$(dirname "${BASH_SOURCE[0]}")/../github_budget.py" foreground "$@"
    fi
    method="" data=false
    args=("${@:2}")
    for ((i=0; i<${#args[@]}; i++)); do
      case ${args[i]} in
        -X|--method)
          ((i+=1))
          [[ ${args[i]:-} == GET ]] || refuse
          method=GET
          ;;
        -XGET|--method=GET) method=GET ;;
        -X*|--method=*) refuse ;;
        -f|-F|--field|--raw-field|--input|-f*|-F*|--field=*|--raw-field=*|--input=*) data=true ;;
        graphql|/graphql|*/graphql) refuse ;;
      esac
    done
    # gh defaults to POST when fields or an input file are present.
    [[ $data == false || $method == GET ]] || refuse
    ;;
  *) refuse ;;
esac
exec env WORKFLOW_GITHUB_RAW_GH="$WORKFLOW_GH" python3 "$(dirname "${BASH_SOURCE[0]}")/../github_budget.py" foreground "$@"
