#!/usr/bin/env bash
# Takes Shipline off again, in one step: the way back of `install-hooks` and `install-timer`.
#
#   shipline uninstall
#
# Shipline's hooks leave the owner's Claude settings, and the hooks they replaced, kept exactly
# in `settings.json.shipline-replaced`, are put back where they were, one an event; every other
# setting and hook is left as it is. The timer's units that `install-timer` replaced, kept as
# `*.before-shipline`, are put back and switched on again; without them Shipline's timer is
# switched off and its units removed, as are the flow page's (`install-flow-page-timer`). The link `~/.local/bin/shipline` goes when it is this
# checkout's. Running the repository's own `install-hooks` afterwards adds nothing twice.
set -euo pipefail

[[ $# == 0 ]] || { echo "usage: uninstall" >&2; exit 2; }
settings=$HOME/.claude/settings.json
record=$settings.shipline-replaced
units=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
launcher=$(cd "$here/../.." && pwd)/bin/shipline

if [[ -e $settings ]]; then
  before=$(jq . "$settings" 2>/dev/null) && jq -e 'type == "object"' >/dev/null <<<"$before" || {
    echo "$settings is not a JSON object; nothing was changed" >&2
    exit 1
  }
  replaced='{}'
  [[ ! -e $record ]] || replaced=$(jq -c . "$record")
  # Keep the file's own indentation, as `install-hooks` does.
  spaces=$(sed -n '/^\( \{1,7\}\)".*/{s//\1/p;q}' "$settings")
  indent=${#spaces}
  ((indent > 0)) || indent=2
  # shellcheck disable=SC2016  # the dollars belong to jq
  after=$(jq --indent "$indent" --argjson replaced "$replaced" '
    def command: if type == "object" and (.command | type) == "string" then .command else "" end;
    # A hook of exactly the shape `install-hooks` writes, whatever checkouts it names.
    def is_shipline:
      command | test("^((SHIPLINE_CONFIG|XDG_CONFIG_HOME)=([^;&|\\\\ ]|\\\\.)+ )*bash ([^;&|\\\\ ]|\\\\.)+/bin/shipline --repo ([^;&|\\\\ ]|\\\\.)+ notify 2>/dev/null \\|\\| true$");
    # A hook of the shape written when the scripts were in the repository.
    def held:
      command | test("^bash ([^;&|\\\\]|\\\\.)*/scripts/workflow/notify 2>/dev/null \\|\\| true$");
    def hooks_of: if type == "object" and (.hooks | type) == "array" then .hooks else [] end;
    def has_shipline: any(hooks_of[]; is_shipline);
    # The groups of one event, the hooks of Shipline out. The hook they replaced goes back in place of
    # the first, under the same matcher, unless the event already runs one of that shape: one
    # notify hook an event. A group left empty by this goes; the others stay as they are.
    def restore($kept):
      reduce .[] as $group ({groups: [], done: ($kept == null or any(.[]; any(hooks_of[]; held)))};
        if ($group | has_shipline) then
          (reduce $group.hooks[] as $hook ({hooks: [], done: .done};
            if ($hook | is_shipline) then
              if (.done | not) and $kept.matcher == ($group.matcher // "") then
                {hooks: (.hooks + [$kept.hook]), done: true}
              else . end
            else .hooks += [$hook] end)) as $out
          | .done = $out.done
          | if ($out.hooks | length) > 0 then .groups += [$group | .hooks = $out.hooks] else . end
        else .groups += [$group] end)
      | .groups;
    if (.hooks | type) != "object" then . else
      (.hooks | length) as $had
      | .hooks |= (to_entries
          | map(.key as $event
              | if (.value | type) == "array" and any(.value[]; has_shipline) then
                  (.value | restore($replaced[$event])) as $groups
                  | if $groups == [] then empty else .value = $groups end
                else . end)
          | from_entries)
      | if $had > 0 and .hooks == {} then del(.hooks) else . end
    end' <<<"$before")
  if [[ $(jq -S . <<<"$after") != "$(jq -S . <<<"$before")" ]]; then
    # Written through the file's own name, so a settings file that is a link stays one.
    printf '%s\n' "$after" >"$settings"
    echo "took Shipline's hooks out of $settings and put back the ones they replaced"
  fi
  rm -f "$record"
fi

service=$units/workflow-tick.service
if [[ -e $service.before-shipline ]]; then
  mv "$service.before-shipline" "$service"
  [[ ! -e $units/workflow-tick.timer.before-shipline ]] ||
    mv "$units/workflow-tick.timer.before-shipline" "$units/workflow-tick.timer"
  systemctl --user daemon-reload
  systemctl --user enable --now workflow-tick.timer
  echo "workflow-tick runs as it did before Shipline"
elif [[ -e $service ]] && grep -q '/bin/shipline" tick$' "$service"; then
  systemctl --user disable --now workflow-tick.timer
  rm -f "$service" "$units/workflow-tick.timer"
  systemctl --user daemon-reload
  echo "workflow-tick is switched off"
fi

# The flow page's units run Shipline too (`install-flow-page-timer`): they go with it. Units of
# that name that run something else are the owner's own and stay.
flow_page=$units/flow-page.service
flow_page_serve=$units/flow-page-serve.service
runs_shipline='/bin/shipline" --repo ".*" flow-page'
if [[ -e $flow_page ]] && grep -q "^ExecStart=.*$runs_shipline\$" "$flow_page"; then
  systemctl --user disable --now flow-page.timer
  rm -f "$flow_page" "$units/flow-page.timer"
  removed=1
fi
if [[ -e $flow_page_serve ]] && grep -q "^ExecStart=.*$runs_shipline --serve [0-9]*\$" "$flow_page_serve"; then
  systemctl --user disable --now flow-page-serve.service
  rm -f "$flow_page_serve"
  removed=1
fi
if [[ -n ${removed:-} ]]; then
  systemctl --user daemon-reload
  echo "the flow page is switched off"
fi

link=$HOME/.local/bin/shipline
if [[ -L $link && $(readlink "$link") == "$launcher" ]]; then
  rm -f "$link"
  echo "removed $link"
fi
