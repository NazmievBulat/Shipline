{
  "repository": "example-owner/example-app",
  "state_folder": ".local/shipline",
  "worktree_setup": "tools/prepare-worktree",
  "commands": {
    "test": "tools/run-tests",
    "browser_tests_for_changes": "tools/shipline/browser-tests-for-changes",
    "server_tests_for_changes": "tools/shipline/server-tests-for-changes",
    "pre_train_checks": "tools/shipline/pre-train-checks",
    "mechanical_conflicts": "tools/shipline/mechanical-conflicts",
    "browser_plan": "tools/shipline/browser-plan",
    "hunt_app": "tools/shipline/hunt-app",
    "hunt_browser": "node tools/shipline/hunt-browser.mjs",
    "hunt_cursor": "tools/shipline/hunt-cursor",
    "advisory_watch": "tools/shipline/advisory-watch",
    "push_checkout": "tools/shipline/push-checkout",
    "push_checks": "tools/shipline/push-checks"
  },
  "checks": {
    "ci_result": "Build result",
    "ci_plan": "Build: what to run",
    "e2e_plan": "Browser: what to run",
    "images": "Images",
    "dependency_audit": "Build: dependencies",
    "advisory_annotation": "Advisory"
  },
  "annotations": {
    "merge_tested": "Merge built",
    "files_tested": "Tree tested",
    "server_tests": "Server suite",
    "web_suite": "Web unit suite",
    "browser_suite": "Browser specs"
  },
  "workflows": {
    "ci": "build.yml",
    "e2e": "browser.yml",
    "images": "images.yml"
  },
  "labels": {
    "workflow": "shipline",
    "audited": "audited",
    "priority": {
      "blocker": "priority: blocker",
      "high": "priority: high",
      "medium": "priority: medium",
      "low": "priority: low"
    }
  },
  "runner": {
    "labels": [
      "example-app-home",
      "example-app-home-standby",
      "example-app-home-first",
      "example-app-home-main",
      "example-app-home-docker",
      "example-app-home-planner"
    ],
    "identity_folder": "~/.config/shipline-runner",
    "prefix": "example-app",
    "label": "example-app-home",
    "planner_label": "example-app-home-planner",
    "image_build": "tools/shipline/build-runner-images",
    "hub_cache": "tools/shipline/hub-cache"
  },
  "cloud_wake_after_minutes": 45,
  "parity": {
    "workflow_tests": "tools/shipline/tests",
    "runner_tests": "tools/runner/tests",
    "known": "tools/shipline/parity-known.txt"
  },
  "machines": [
    {"name": "this machine"},
    {"name": "runner-1", "address": "runner@runner-1.example"}
  ],
  "hunts": {
    "areas": {
      "phone": ["/calls", "/contacts"],
      "billing": ["/invoices", "/settings/billing"]
    },
    "plans": "docs/hunt-plans.md"
  },
  "review": {
    "high_effort_paths": [
      "^db/migrations/", "^db/schema\\.sql$", "^app/models/",
      "^prompts/", "(^|/)AGENTS\\.md$", "\\.prompt\\.md$",
      "^app/jobs/", "^app/queues/", "(^|/)locks?\\.py$",
      "^app/auth/", "^app/permissions/", "^config/secrets"
    ]
  },
  "answer_for_owner_after_minutes": 15,
  "cloud_pre_push": {
    "suites": {
      "server": {
        "select": "tools/shipline/server-tests-for-changes",
        "run": "tools/shipline/server-tests --workers {workers}",
        "workers": 4,
        "part": "--shard {shard}/{shards}"
      },
      "browser": {
        "select": "tools/shipline/browser-tests-for-changes --ci",
        "run": "tools/shipline/browser-tests --workers {workers}",
        "workers": 2,
        "probe": "tools/shipline/browser-starts"
      }
    }
  }
}
