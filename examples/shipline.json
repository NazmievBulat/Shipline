{
  "repository": "example-owner/example-app",
  "state_folder": ".local/shipline",
  "worktree_setup": "tools/prepare-worktree",
  "checks": {
    "ci_result": "Build result",
    "ci_plan": "Build: what to run",
    "e2e_plan": "Browser: what to run",
    "images": "Images"
  },
  "annotations": {
    "merge_tested": "Merge built",
    "files_tested": "Tree tested",
    "server_tests": "Server suite",
    "web_suite": "Web unit suite",
    "browser_suite": "Browser specs"
  },
  "workflows": {
    "ci": "build.yml",
    "e2e": "browser.yml",
    "images": "images.yml"
  },
  "labels": {
    "workflow": "shipline",
    "audited": "audited",
    "priority": {
      "blocker": "priority: blocker",
      "high": "priority: high",
      "medium": "priority: medium",
      "low": "priority: low"
    }
  },
  "runner": {
    "labels": ["example-app-home", "example-app-home-main", "example-app-home-docker", "example-app-planner"],
    "identity_folder": "~/.config/example-app-runner",
    "prefix": "example-app-runner"
  },
  "commands": {
    "push_checks": "tools/shipline/push-checks"
  },
  "cloud_pre_push": {
    "suites": {
      "server": {
        "select": "tools/shipline/server-tests-for-changes",
        "run": "tools/shipline/server-tests --workers {workers}",
        "workers": 4,
        "part": "--shard {shard}/{shards}"
      },
      "browser": {
        "select": "tools/shipline/browser-tests-for-changes --ci",
        "run": "tools/shipline/browser-tests --workers {workers}",
        "workers": 2,
        "probe": "tools/shipline/browser-starts"
      }
    }
  }
}
