# The spare supervisor: keeps a registered spare runner ready (`<label>-standby` until it takes
# a slot), so a slot that ends is replaced without waiting for a new registration.
[Unit]
Description=@PREFIX@ spare runner supervisor
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
User=@PREFIX@-runner
WorkingDirectory=/var/lib/@PREFIX@-runner
ExecStart=/opt/@PREFIX@-runner/keep-spare.sh
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
