# One ordinary runner of the pool, slot %i: a container of the image @PREFIX@-runner, named
# `<machine>-%i`. Every machine's runners carry the same labels, so GitHub gives a job to
# whichever machine has one free.
[Unit]
Description=@PREFIX@ ordinary runner %i
Requires=docker.service @PREFIX@-runner-network.service
After=docker.service @PREFIX@-runner-network.service @PREFIX@-runner-hub-cache.service
Wants=@PREFIX@-runner-hub-cache.service

[Service]
User=@PREFIX@-runner
WorkingDirectory=/var/lib/@PREFIX@-runner
ExecStart=/opt/@PREFIX@-runner/start-runner.sh ordinary %i
Restart=always
RestartSec=10
# A job that is running is given its time to end before the container goes.
TimeoutStopSec=330
KillMode=mixed

[Install]
WantedBy=multi-user.target
