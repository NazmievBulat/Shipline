# The container network of the pool, @PREFIX@-runner: the runners reach the hub cache on it.
[Unit]
Description=@PREFIX@ runner network
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'docker network inspect @PREFIX@-runner >/dev/null 2>&1 || docker network create @PREFIX@-runner'

[Install]
WantedBy=multi-user.target
