# One sample of what the pool's runners use, written for the usage report.
[Unit]
Description=@PREFIX@ runner usage sample

[Service]
Type=oneshot
User=@PREFIX@-runner
WorkingDirectory=/var/lib/@PREFIX@-runner
ExecStart=/opt/@PREFIX@-runner/sample-usage.sh
# The next sample is due in a minute: one that hangs gives way to it.
TimeoutStartSec=50s
NoNewPrivileges=true
