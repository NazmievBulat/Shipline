# One of main's runners, slot %i, on the main machine only: a container of the image
# @PREFIX@-runner, named `<machine>-main`, that takes main's jobs (`<label>-main`). The lender
# gives it to pull request jobs while main has none.
[Unit]
Description=@PREFIX@ main runner %i
Requires=docker.service @PREFIX@-runner-network.service
After=docker.service @PREFIX@-runner-network.service @PREFIX@-runner-hub-cache.service
Wants=@PREFIX@-runner-hub-cache.service

[Service]
User=@PREFIX@-runner
WorkingDirectory=/var/lib/@PREFIX@-runner
ExecStart=/opt/@PREFIX@-runner/start-runner.sh main %i
Restart=always
RestartSec=10
TimeoutStopSec=330
KillMode=mixed

[Install]
WantedBy=multi-user.target
