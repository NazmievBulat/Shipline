# A pull-through cache of Docker Hub on the pool's network, so the runners' image pulls count
# once against Docker Hub's limits and come from this machine after that.
[Unit]
Description=@PREFIX@ runner Docker Hub cache
Requires=docker.service @PREFIX@-runner-network.service
After=docker.service @PREFIX@-runner-network.service

[Service]
ExecStartPre=-/usr/bin/docker rm -f @PREFIX@-runner-hub-cache
ExecStart=/usr/bin/docker run --rm --name @PREFIX@-runner-hub-cache --network @PREFIX@-runner \
  --volume @PREFIX@-runner-hub-cache:/var/lib/registry \
  --env REGISTRY_PROXY_REMOTEURL=https://registry-1.docker.io registry:2.8.3
ExecStop=/usr/bin/docker stop @PREFIX@-runner-hub-cache
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
