# Builds the runner images again: GitHub refuses runners that fall far behind its own version.
# The install writes the checkout link and images.env; the build runs from the repository's main
# checkout, with the repository's own command when its shipline.json names one.
[Unit]
Description=@PREFIX@ runner images build
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@PREFIX@-runner
WorkingDirectory=/var/lib/@PREFIX@-runner/checkout
EnvironmentFile=/var/lib/@PREFIX@-runner/images.env
ExecStart=/opt/@PREFIX@-runner/build-images.sh
