# The lender: while main has no job, lends main's runners to pull request jobs, the first member
# of the merge train first, and takes them back when main needs them.
[Unit]
Description=@PREFIX@ runner lender
After=network-online.target
Wants=network-online.target

[Service]
User=@PREFIX@-runner
WorkingDirectory=/var/lib/@PREFIX@-runner
ExecStart=/usr/bin/python3 /opt/@PREFIX@-runner/lend_runners.py
Restart=always
RestartSec=30
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
