[Unit]
Description=CI runner %i for @PREFIX@ jobs that need Docker (a fresh virtual machine for each job)

[Service]
ExecStart=%h/.local/share/@PREFIX@-runner/keep-runner.sh %i docker
ExecStopPost=-/usr/bin/docker rm -f @PREFIX@-runner-docker-%i
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
