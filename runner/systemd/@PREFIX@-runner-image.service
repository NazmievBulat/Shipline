[Unit]
Description=Rebuild the @PREFIX@ CI runner images on the newest runner from GitHub

[Service]
Type=oneshot
ExecStart=%h/.local/share/@PREFIX@-runner/build-images.sh
# Waiting runners hold containers of the old images, so they start again on the new ones. A job
# that happens to run at that moment is cut off and has to be run again.
ExecStartPost=/usr/bin/systemctl --user try-restart @PREFIX@-runner-main.service @PREFIX@-runner-main-2.service @PREFIX@-runner-planner.service @PREFIX@-runner@*.service @PREFIX@-runner-docker@*.service
