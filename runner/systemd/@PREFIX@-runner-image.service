[Unit]
Description=Rebuild the example-app CI runner images on the newest runner from GitHub

[Service]
Type=oneshot
ExecStart=%h/.local/share/example-app-runner/build-images.sh
# Waiting runners hold containers of the old images, so they start again on the new ones. A job
# that happens to run at that moment is cut off and has to be run again.
ExecStartPost=/usr/bin/systemctl --user try-restart example-app-runner-main.service example-app-runner-main-2.service example-app-runner-planner.service example-app-runner@*.service example-app-runner-docker@*.service
