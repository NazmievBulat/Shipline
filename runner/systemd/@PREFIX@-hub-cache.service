[Unit]
Description=Shared Docker Hub pull-through cache for CI virtual machines

[Service]
ExecStartPre=-/usr/bin/docker rm -f @PREFIX@-hub-cache
ExecStart=%h/.local/share/@PREFIX@-runner/hub-cache.sh
ExecStopPost=-/usr/bin/docker rm -f @PREFIX@-hub-cache
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
