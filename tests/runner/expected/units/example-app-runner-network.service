# The container network of the pool, example-app-runner: the runners reach the hub cache on it.
[Unit]
Description=example-app runner network
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'docker network inspect example-app-runner >/dev/null 2>&1 || docker network create example-app-runner'

[Install]
WantedBy=multi-user.target
