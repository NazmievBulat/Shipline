# One Docker-capable runner, slot %i: a virtual machine of the image example-app-runner-docker,
# named `<machine>-docker-%i`, for the jobs that run Docker themselves (`<label>-docker`). Only
# on a machine that has /dev/kvm.
[Unit]
Description=example-app Docker runner %i
ConditionPathExists=/dev/kvm
Requires=docker.service example-app-runner-network.service
After=docker.service example-app-runner-network.service example-app-runner-hub-cache.service
Wants=example-app-runner-hub-cache.service

[Service]
User=example-app-runner
WorkingDirectory=/var/lib/example-app-runner
ExecStart=/opt/example-app-runner/start-runner.sh docker %i
Restart=always
RestartSec=10
TimeoutStopSec=330
KillMode=mixed

[Install]
WantedBy=multi-user.target
