# One sample of what the pool's runners use, written for the usage report.
[Unit]
Description=example-app runner usage sample

[Service]
Type=oneshot
User=example-app-runner
WorkingDirectory=/var/lib/example-app-runner
ExecStart=/opt/example-app-runner/sample-usage.sh
# The next sample is due in a minute: one that hangs gives way to it.
TimeoutStartSec=50s
NoNewPrivileges=true
