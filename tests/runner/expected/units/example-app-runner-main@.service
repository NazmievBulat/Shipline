# One of main's runners, slot %i: a container of the image example-app-runner that takes main's
# jobs, labelled with this machine's main label. The lender gives it to pull request jobs while
# main has none.
[Unit]
Description=example-app main runner %i
Requires=docker.service example-app-runner-network.service
After=docker.service example-app-runner-network.service example-app-runner-hub-cache.service
Wants=example-app-runner-hub-cache.service

[Service]
User=example-app-runner
WorkingDirectory=/var/lib/example-app-runner
ExecStart=/opt/example-app-runner/start-runner.sh main %i
Restart=always
RestartSec=10
TimeoutStopSec=330
KillMode=mixed

[Install]
WantedBy=multi-user.target
