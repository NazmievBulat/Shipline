# The spare supervisor: keeps a registered spare runner ready, so a slot that ends is replaced
# without waiting for a new registration.
[Unit]
Description=example-app spare runner supervisor
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
User=example-app-runner
WorkingDirectory=/var/lib/example-app-runner
ExecStart=/opt/example-app-runner/keep-spare.sh
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
