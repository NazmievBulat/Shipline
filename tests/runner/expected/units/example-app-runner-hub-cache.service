# A pull-through cache of Docker Hub on the pool's network, so the runners' image pulls count
# once against Docker Hub's limits and come from this machine after that.
[Unit]
Description=example-app runner Docker Hub cache
Requires=docker.service example-app-runner-network.service
After=docker.service example-app-runner-network.service

[Service]
ExecStartPre=-/usr/bin/docker rm -f example-app-runner-hub-cache
ExecStart=/usr/bin/docker run --rm --name example-app-runner-hub-cache --network example-app-runner \
  --volume example-app-runner-hub-cache:/var/lib/registry \
  --env REGISTRY_PROXY_REMOTEURL=https://registry-1.docker.io registry:2.8.3
ExecStop=/usr/bin/docker stop example-app-runner-hub-cache
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
