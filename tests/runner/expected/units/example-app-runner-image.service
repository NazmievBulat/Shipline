# Builds the runner images again: GitHub refuses runners that fall far behind its own version.
# The install writes the checkout link and images.env; the build runs from the repository's main
# checkout, with the repository's own command when its shipline.json names one.
[Unit]
Description=example-app runner images build
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=example-app-runner
WorkingDirectory=/var/lib/example-app-runner/checkout
EnvironmentFile=/var/lib/example-app-runner/images.env
ExecStart=/opt/example-app-runner/build-images.sh
