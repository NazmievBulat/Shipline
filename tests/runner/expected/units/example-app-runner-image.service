# Builds the runner images again: GitHub refuses runners that fall far behind its own version.
# It runs in the repository's main checkout, a link the install writes, and builds from main as
# last fetched, with the repository's own command when main's shipline.json names one.
[Unit]
Description=example-app runner images build
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=example-app-runner
WorkingDirectory=/var/lib/example-app-runner/checkout
Environment=RUNNER_PREFIX=example-app
ExecStart=/opt/example-app-runner/build-images.sh
# A build that hangs on a registry gives way, so next week's runs.
TimeoutStartSec=2h
