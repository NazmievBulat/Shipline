#!/usr/bin/env python3
"""A stand-in for the repository's browser plan, its `browser_plan` command, which the merge
gate asks whether a merge needs browser tests: the changed paths on standard input, each ended
by a NUL; exit 0 when they are needed, 1 when not.

A change to the workflow, the tests, the docs or Markdown alone needs none; any other change
does, and so does an empty one, which the planner cannot tell from a misread.
"""

import sys

_NONE_NEEDED = (b"scripts/workflow/", b"tests/", b"docs/")

changed = sys.stdin.buffer.read().split(b"\0")[:-1]
needed = not changed or not all(
    path.startswith(_NONE_NEEDED) or path.endswith(b".md") for path in changed
)
sys.exit(0 if needed else 1)
